---
import Base from "../layouts/Base.astro";
import { SITE, CATEGORIES } from "../site.config.mjs";
import { t, lp, type Lang } from "../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const enabled = Boolean(SITE.supabaseUrl && SITE.supabaseAnonKey);
const levels = ["Bachelor", "Master", "PhD", "Postdoc"];
const msgs = { error: t(lang, "account.error"), check: t(lang, "account.checkEmail"), reset: t(lang, "account.resetSent"), saved: t(lang, "account.prefsSaved") };
---
<Base lang={lang} title={t(lang, "account.title")} description={t(lang, "site.description")} path="/account/" noindex>
  <div class="container account" data-account data-enabled={enabled ? "1" : ""} data-lang={lang} data-msgs={JSON.stringify(msgs)} data-redirect={new URL(lp(lang, "/account/"), SITE.url).pathname}>
    <nav class="crumbs" aria-label="Breadcrumb"><a href={lp(lang, "/")}>{t(lang, "nav.home")}</a> / <span>{t(lang, "account.title")}</span></nav>

    {!enabled && <p class="notice">{t(lang, "account.soon")}</p>}

    <section class="auth-box" data-view="auth" hidden>
      <img src="/brand-icon.png" alt="" width="69" height="60" />
      <div class="tabs" role="tablist">
        <button type="button" role="tab" data-tab="signin" aria-selected="true">{t(lang, "account.signin")}</button>
        <button type="button" role="tab" data-tab="signup" aria-selected="false">{t(lang, "account.signup")}</button>
      </div>
      <form class="form" data-form="signin">
        <label>{t(lang, "account.email")}<input name="email" type="email" required autocomplete="email" /></label>
        <label>{t(lang, "account.password")}<input name="password" type="password" required minlength="8" autocomplete="current-password" /></label>
        <button class="btn" type="submit">{t(lang, "account.signin")}</button>
        <button class="linkish" type="button" data-forgot>{t(lang, "account.forgot")}</button>
      </form>
      <form class="form" data-form="signup" hidden>
        <label>{t(lang, "account.name")}<input name="name" type="text" required autocomplete="name" /></label>
        <label>{t(lang, "account.email")}<input name="email" type="email" required autocomplete="email" /></label>
        <label>{t(lang, "account.password")}<input name="password" type="password" required minlength="8" autocomplete="new-password" /><small>{t(lang, "account.pwHint")}</small></label>
        <label class="check"><input name="newsletter" type="checkbox" checked /> {t(lang, "account.newsletter")}</label>
        <button class="btn" type="submit">{t(lang, "account.signup")}</button>
      </form>
      <form class="form" data-form="recover" hidden>
        <label>{t(lang, "account.password")}<input name="password" type="password" required minlength="8" autocomplete="new-password" /><small>{t(lang, "account.pwHint")}</small></label>
        <button class="btn" type="submit">{t(lang, "account.prefsSave")}</button>
      </form>
      {SITE.googleSignIn && (
        <>
          <div class="or"><span>{t(lang, "account.or")}</span></div>
          <button class="btn outline google" type="button" data-google>
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.2-2.1 3.5-5.1 3.5-8.7z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6h-4a12 12 0 0 0 0 10.8l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-4.9 6.7-4.9z"/></svg>
            {t(lang, "account.google")}
          </button>
        </>
      )}
      <p class="msg" data-msg role="status" hidden></p>
    </section>

    <section class="dash" data-view="dash" hidden>
      <header class="dash-head">
        <h1><span>{t(lang, "account.welcome")}</span> <span data-username></span></h1>
        <button class="btn outline" type="button" data-logout>{t(lang, "account.logout")}</button>
      </header>
      <div class="dash-grid">
        <section class="panel">
          <h2>{t(lang, "account.saved")}</h2>
          <ul class="saved" data-saved></ul>
          <p class="muted" data-saved-empty hidden>{t(lang, "account.savedEmpty")}</p>
        </section>
        <section class="panel" data-prefs-panel>
          <h2>{t(lang, "account.prefs")}</h2>
          <p class="muted">{t(lang, "account.prefsLead")}</p>
          <form class="form" data-form="prefs">
            <fieldset><legend>{t(lang, "account.categories")}</legend>
              {CATEGORIES.map((c) => <label class="check"><input type="checkbox" name="categories" value={c} /> {t(lang, `cat.${c}` as any)}</label>)}
            </fieldset>
            <fieldset><legend>{t(lang, "account.levels")}</legend>
              {levels.map((l) => <label class="check"><input type="checkbox" name="levels" value={l} /> {t(lang, `level.${l}` as any)}</label>)}
            </fieldset>
            <label class="check"><input type="checkbox" name="newsletter" /> {t(lang, "account.newsletter")}</label>
            <button class="btn" type="submit">{t(lang, "account.prefsSave")}</button>
            <p class="msg" data-prefs-msg role="status" hidden></p>
          </form>
        </section>
      </div>
    </section>
  </div>
</Base>

<script>
  import { getSupabase, accountsEnabled } from "../lib/client/supabase";
  import { listSaved, toggleSaved } from "../lib/client/saved";

  const root = document.querySelector<HTMLElement>("[data-account]")!;
  const msgs = JSON.parse(root.dataset.msgs || "{}");
  const view = (name: "auth" | "dash") => root.querySelectorAll<HTMLElement>("[data-view]").forEach((v) => (v.hidden = v.dataset.view !== name));
  const msg = root.querySelector<HTMLElement>("[data-msg]")!;
  const say = (text: string, bad = false) => { msg.hidden = false; msg.textContent = text; msg.classList.toggle("bad", bad); };
  const form = (n: string) => root.querySelector<HTMLFormElement>(`[data-form="${n}"]`)!;

  function tab(name: "signin" | "signup" | "recover") {
    root.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.tab === name)));
    ["signin", "signup", "recover"].forEach((n) => (form(n).hidden = n !== name));
    msg.hidden = true;
  }
  root.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((b) => b.addEventListener("click", () => tab(b.dataset.tab as any)));
  if (location.hash === "#signup") tab("signup");

  async function renderSaved() {
    const list = root.querySelector<HTMLUListElement>("[data-saved]")!;
    const items = await listSaved();
    list.replaceChildren(...items.map((it) => {
      const li = document.createElement("li");
      const a = document.createElement("a"); a.href = it.href; a.textContent = it.title || it.slug;
      const rm = document.createElement("button"); rm.type = "button"; rm.className = "rm"; rm.textContent = "×"; rm.setAttribute("aria-label", "Remove");
      rm.addEventListener("click", async () => { await toggleSaved(it); renderSaved(); });
      li.append(a, rm); return li;
    }));
    root.querySelector<HTMLElement>("[data-saved-empty]")!.hidden = items.length > 0;
  }

  async function main() {
    if (!accountsEnabled) {
      // No accounts yet: show what this browser has saved.
      view("dash");
      root.querySelector<HTMLElement>(".dash-head")!.hidden = true;
      root.querySelector<HTMLElement>("[data-prefs-panel]")!.hidden = true;
      renderSaved();
      return;
    }
    const sb = (await getSupabase())!;
    const redirectTo = location.origin + root.dataset.redirect;

    sb.auth.onAuthStateChange((event) => { if (event === "PASSWORD_RECOVERY") { view("auth"); tab("recover"); } });

    form("signin").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = new FormData(form("signin"));
      const { error } = await sb.auth.signInWithPassword({ email: String(f.get("email")), password: String(f.get("password")) });
      if (error) return say(msgs.error, true);
      location.reload();
    });
    form("signup").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = new FormData(form("signup"));
      const { data, error } = await sb.auth.signUp({
        email: String(f.get("email")), password: String(f.get("password")),
        options: { emailRedirectTo: redirectTo, data: { full_name: String(f.get("name")), newsletter: f.get("newsletter") === "on", lang: root.dataset.lang } },
      });
      if (error) return say(msgs.error, true);
      if (data.session) location.reload(); else say(msgs.check);
    });
    form("recover").addEventListener("submit", async (e) => {
      e.preventDefault();
      const { error } = await sb.auth.updateUser({ password: String(new FormData(form("recover")).get("password")) });
      if (error) return say(msgs.error, true);
      location.reload();
    });
    root.querySelector("[data-forgot]")!.addEventListener("click", async () => {
      const email = (form("signin").elements.namedItem("email") as HTMLInputElement).value.trim();
      if (!email) return (form("signin").elements.namedItem("email") as HTMLInputElement).focus();
      const { error } = await sb.auth.resetPasswordForEmail(email, { redirectTo });
      say(error ? msgs.error : msgs.reset, !!error);
    });
    root.querySelector("[data-google]")?.addEventListener("click", () => sb.auth.signInWithOAuth({ provider: "google", options: { redirectTo } }));
    root.querySelector("[data-logout]")!.addEventListener("click", async () => { await sb.auth.signOut(); location.reload(); });

    const { data: { session } } = await sb.auth.getSession();
    if (!session) return view("auth");

    view("dash");
    const user = session.user;
    root.querySelector<HTMLElement>("[data-username]")!.textContent = user.user_metadata?.full_name || user.email || "";
    renderSaved();

    const prefs = form("prefs");
    const { data: profile } = await sb.from("profiles").select("categories,levels,newsletter").eq("id", user.id).maybeSingle();
    const setChecks = (name: string, vals: string[] = []) => prefs.querySelectorAll<HTMLInputElement>(`[name="${name}"]`).forEach((i) => (i.checked = vals.includes(i.value)));
    setChecks("categories", profile?.categories ?? []);
    setChecks("levels", profile?.levels ?? []);
    (prefs.elements.namedItem("newsletter") as HTMLInputElement).checked = profile?.newsletter ?? !!user.user_metadata?.newsletter;
    prefs.addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = new FormData(prefs);
      const { error } = await sb.from("profiles").upsert({
        id: user.id, email: user.email, full_name: user.user_metadata?.full_name ?? null, lang: root.dataset.lang,
        categories: f.getAll("categories"), levels: f.getAll("levels"), newsletter: f.get("newsletter") === "on",
      });
      const m = root.querySelector<HTMLElement>("[data-prefs-msg]")!;
      m.hidden = false; m.textContent = error ? msgs.error : msgs.saved; m.classList.toggle("bad", !!error);
    });
  }
  main();
</script>

<style>
  .account { padding-bottom: 24px; }
  .notice { margin: 20px 0 0; padding: 14px 16px; border-radius: 12px; background: var(--brand-soft); color: var(--navy); font-weight: 600; }
  .auth-box { max-width: 440px; margin: 32px auto 0; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 28px; display: grid; gap: 16px; box-shadow: var(--shadow); }
  .auth-box > img { justify-self: center; height: 56px; width: auto; }
  .tabs { display: grid; grid-template-columns: 1fr 1fr; background: var(--surface-2); border-radius: 12px; padding: 4px; }
  .tabs button { border: 0; background: transparent; padding: 10px; border-radius: 9px; font-weight: 700; cursor: pointer; color: var(--muted); }
  .tabs button[aria-selected="true"] { background: var(--surface); color: var(--navy); box-shadow: 0 1px 3px rgb(12 43 76 / .12); }
  .form { display: grid; gap: 14px; }
  .form label:not(.check) { display: grid; gap: 6px; font-weight: 600; font-size: .92rem; color: var(--navy); }
  .form input:not([type=checkbox]) { padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); font-weight: 400; }
  .form input:focus { outline: none; border-color: var(--teal); box-shadow: 0 0 0 3px var(--brand-soft); }
  small { color: var(--muted); font-weight: 400; }
  .check { display: flex; align-items: center; gap: 8px; font-size: .94rem; cursor: pointer; }
  .check input { width: 17px; height: 17px; accent-color: var(--brand); }
  .linkish { background: none; border: 0; color: var(--brand); font-weight: 700; cursor: pointer; justify-self: start; padding: 0; }
  .or { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: .85rem; }
  .or::before, .or::after { content: ""; flex: 1; height: 1px; background: var(--line); }
  .google { color: var(--ink); border-color: var(--line); }
  .msg { margin: 0; font-weight: 600; color: var(--brand); }
  .msg.bad { color: var(--danger); }
  .dash { padding-top: 20px; display: grid; gap: 20px; }
  .dash-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .dash-head h1 { font-size: clamp(1.6rem, 3.5vw, 2.2rem); color: var(--navy); }
  .dash-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; display: grid; gap: 12px; }
  .panel h2 { font-size: 1.2rem; color: var(--navy); }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }
  legend { font-weight: 800; color: var(--navy); margin-bottom: 4px; padding: 0; }
  .saved { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .saved li { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; }
  .saved a { font-weight: 700; color: var(--ink); text-decoration: none; min-width: 0; overflow-wrap: anywhere; }
  .saved a:hover { color: var(--brand); }
  .rm { border: 0; background: var(--surface-2); width: 30px; height: 30px; border-radius: 50%; cursor: pointer; font-size: 1.1rem; color: var(--muted); flex: none; }
  .muted { color: var(--muted); margin: 0; }
  @media (max-width: 820px) { .dash-grid { grid-template-columns: 1fr; } }
</style>
