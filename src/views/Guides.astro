---
import Base from "../layouts/Base.astro";
import Newsletter from "../components/Newsletter.astro";
import { t, lp, type Lang } from "../i18n/ui";
import type { Guide } from "../lib/opps";
interface Props { lang: Lang; guides: Guide[] }
const { lang, guides } = Astro.props;
const topics = ["apply", "documents", "visa", "tips"].filter((tp) => guides.some((g) => g.entry.data.topic === tp));
---
<Base lang={lang} title={t(lang, "guides.title")} description={t(lang, "guides.lead")} path="/guides/">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={lp(lang, "/")}>{t(lang, "nav.home")}</a> / <span>{t(lang, "guides.title")}</span></nav>
    <header class="page-head">
      <h1>{t(lang, "guides.title")}</h1>
      <p>{t(lang, "guides.lead")}</p>
    </header>
    {topics.map((tp) => (
      <section class="section">
        <div class="section-head"><h2>{t(lang, `topic.${tp}` as any)}</h2></div>
        <div class="guide-grid">
          {guides.filter((g) => g.entry.data.topic === tp).map((g) => (
            <a class="guide-card" href={lp(lang, `/guides/${g.slug}/`)}>
              <strong>{g.entry.data.title}</strong>
              <span class="muted">{g.entry.data.summary}</span>
              <span class="read">{t(lang, "guides.read", { n: g.entry.data.readingMinutes })}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
    <Newsletter lang={lang} />
  </div>
</Base>
