---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Newsletter from "../components/Newsletter.astro";
import AdSlot from "../components/AdSlot.astro";
import { SITE } from "../site.config.mjs";
import { t, lp, type Lang } from "../i18n/ui";
import { isoDate, formatDate, translatedLangs, type Guide } from "../lib/opps";
interface Props { lang: Lang; guides: Guide[]; guide: Guide }
const { lang, guides, guide } = Astro.props;
const d = guide.entry.data;
const { Content } = await render(guide.entry);
const path = `/guides/${guide.slug}/`;
const translatedIn = await translatedLangs("guides", guide.slug);
const url = new URL(lp(lang, path), SITE.url).href;
const more = guides.filter((g) => g.slug !== guide.slug).slice(0, 3);
const jsonLd = [
  { "@context": "https://schema.org", "@type": "Article", headline: d.title, description: d.summary, inLanguage: guide.translated ? lang : "en",
    datePublished: isoDate(d.published), mainEntityOfPage: url, author: { "@type": "Organization", name: SITE.name, url: SITE.url },
    publisher: { "@type": "Organization", name: SITE.name, logo: { "@type": "ImageObject", url: new URL("/brand-logo.png", SITE.url).href } } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: SITE.name, item: new URL(lp(lang, "/"), SITE.url).href },
    { "@type": "ListItem", position: 2, name: t(lang, "guides.title"), item: new URL(lp(lang, "/guides/"), SITE.url).href },
    { "@type": "ListItem", position: 3, name: d.title, item: url } ] },
];
---
<Base lang={lang} title={d.title} description={d.summary} path={path} ogType="article" jsonLd={jsonLd} translatedIn={translatedIn}>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={lp(lang, "/")}>{t(lang, "nav.home")}</a> / <a href={lp(lang, "/guides/")}>{t(lang, "guides.title")}</a></nav>
    <article class="guide">
      <span class="topic">{t(lang, `topic.${d.topic}` as any)}</span>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
      <p class="meta">{formatDate(d.published, lang)} · {t(lang, "guides.read", { n: d.readingMinutes })}</p>
      {!guide.translated && <p class="note">{t(lang, "guides.untranslated")}</p>}
      <AdSlot slot="" />
      <div class="prose" lang={guide.translated ? lang : "en"} dir={guide.translated ? undefined : "ltr"}><Content /></div>
      <div class="cta">
        <a class="btn" href={lp(lang, "/opportunities/")}>{t(lang, "browse.title")}</a>
      </div>
    </article>
    {more.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t(lang, "guides.more")}</h2><a href={lp(lang, "/guides/")}>{t(lang, "list.viewAll")}</a></div>
        <div class="guide-grid">
          {more.map((g) => (
            <a class="guide-card" href={lp(lang, `/guides/${g.slug}/`)}>
              <span class="topic">{t(lang, `topic.${g.entry.data.topic}` as any)}</span>
              <strong>{g.entry.data.title}</strong>
              <span class="read">{t(lang, "guides.read", { n: g.entry.data.readingMinutes })}</span>
            </a>
          ))}
        </div>
      </section>
    )}
    <Newsletter lang={lang} />
  </div>
</Base>
<style>
  .guide { max-width: 760px; padding-top: 16px; display: grid; gap: 12px; justify-items: start; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; color: var(--navy); }
  .summary { margin: 0; font-size: 1.12rem; color: var(--muted); }
  .meta { margin: 0; font-size: .9rem; color: var(--muted); }
  .note { margin: 0; padding: 10px 14px; border-radius: 10px; background: var(--surface-2); color: var(--muted); font-size: .92rem; }
  .prose { width: 100%; font-size: 1.04rem; }
  .cta { margin-top: 12px; }
</style>
