---
import Base from "../layouts/Base.astro";
import OppCard from "../components/OppCard.astro";
import Newsletter from "../components/Newsletter.astro";
import Deadlines from "../components/Deadlines.astro";
import AdSlot from "../components/AdSlot.astro";
import Logo from "../components/Logo.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { SITE, CATEGORIES } from "../site.config.mjs";
import { t, lp, type Lang } from "../i18n/ui";
import type { Opp, Guide } from "../lib/opps";
interface Props { lang: Lang; opps: Opp[]; guides: Guide[] }
const { lang, opps, guides } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const isOpen = (o: Opp) => !o.entry.data.deadline || o.entry.data.deadline.toISOString().slice(0, 10) >= today;
const open = opps.filter(isOpen);
const latest = open.slice(0, 6);
const closing = open.filter((o) => o.entry.data.deadline).sort((a, b) => +a.entry.data.deadline! - +b.entry.data.deadline!).slice(0, 3);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, open.filter((o) => o.entry.data.category === c).length]));
const home = new URL(lp(lang, "/"), SITE.url).href;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebSite", name: SITE.name, url: home, inLanguage: lang,
    potentialAction: { "@type": "SearchAction", target: `${new URL(lp(lang, "/opportunities/"), SITE.url).href}?q={search_term_string}`, "query-input": "required name=search_term_string" } },
  { "@context": "https://schema.org", "@type": "Organization", name: SITE.name, url: SITE.url, logo: new URL("/brand-logo.png", SITE.url).href,
    sameAs: [SITE.telegram, ...Object.values(SITE.social)].filter(Boolean) },
];
const stepIcons = [
  '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
  '<path d="M9 11l3 3 8-8"/><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9"/>',
  '<path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4z"/>',
];
const icons: Record<string, string> = {
  scholarships: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/>',
  conferences: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  exchange: '<path d="M4 8h13l-3-3M20 16H7l3 3"/>',
};
---
<Base lang={lang} title={SITE.name} description={t(lang, "site.description")} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>{t(lang, "home.title")}</h1>
        <p class="lead">{t(lang, "home.lead").split(/\[\[|\]\]/).map((part, i) => i % 2 ? <b class="hl">{part}</b> : part)}</p>
        <form class="hero-search" role="search" action={lp(lang, "/opportunities/")} method="get">
          <label class="visually-hidden" for="hero-q">{t(lang, "home.search")}</label>
          <input id="hero-q" name="q" type="search" placeholder={t(lang, "home.search")} />
          <button class="btn" type="submit">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <span class="visually-hidden">{t(lang, "home.search")}</span>
          </button>
        </form>
      </div>
      <Logo variant="stacked" class="hero-logo" />
    </div>
  </section>

  <div class="container">
    <section class="section home-first">
      <div class="section-head"><h2>{t(lang, "home.browse")}</h2><a href={lp(lang, "/opportunities/")}>{t(lang, "list.viewAll")}</a></div>
      <div class="cats">
        {CATEGORIES.map((c) => (
          <a class={`cat ${c}`} href={lp(lang, `/${c}/`)} title={t(lang, `cat.${c}.desc` as any)}>
            <span class="cat-ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[c]} /></span>
            <span class="cat-body">
              <strong class="cat-name">{t(lang, `cat.${c}` as any)}</strong>
              <span class="cat-count"><b>{counts[c]}</b> {t(lang, "cat.openNow")}</span>
            </span>
            <span class="cat-go" aria-hidden="true"><svg class="flip-rtl" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        ))}
      </div>
    </section>

    <section class="section home-latest">
      <div class="section-head"><h2>{t(lang, "home.latest")}</h2><a href={lp(lang, "/opportunities/?sort=new")}>{t(lang, "list.viewAll")}</a></div>
      <div class="cards">{latest.map((o) => <OppCard opp={o} lang={lang} />)}</div>
    </section>

    <AdSlot slot="" />

    {closing.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t(lang, "home.closing")}</h2><a href={lp(lang, "/opportunities/?within=30")}>{t(lang, "list.viewAll")}</a></div>
        <div class="cards">{closing.map((o) => <OppCard opp={o} lang={lang} />)}</div>
      </section>
    )}

    <section class="section how">
      <h2>{t(lang, "how.title")}</h2>
      <ol class="steps">
        {[1, 2, 3].map((n) => (
          <>
            <li class="step">
              <span class="step-ico">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={stepIcons[n - 1]} />
                <span class="step-n">{n}</span>
              </span>
              <strong>{t(lang, `how.${n}.t` as any)}</strong>
              <span class="step-d">{t(lang, `how.${n}.d` as any)}</span>
            </li>
            {n < 3 && (
              <li class="step-arrow" aria-hidden="true">
                <svg width="64" height="24" viewBox="0 0 64 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path class="dash" d="M2 12h52" /><path d="M48 5l8 7-8 7" /></svg>
              </li>
            )}
          </>
        ))}
      </ol>
    </section>

    {guides.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t(lang, "guides.home")}</h2><a href={lp(lang, "/guides/")}>{t(lang, "list.viewAll")}</a></div>
        <div class="guide-grid">
          {guides.slice(0, 3).map((g) => (
            <a class="guide-card" href={lp(lang, `/guides/${g.slug}/`)}>
              <span class="topic">{t(lang, `topic.${g.entry.data.topic}` as any)}</span>
              <strong>{g.entry.data.title}</strong>
              <span class="muted">{g.entry.data.summary}</span>
              <span class="read">{t(lang, "guides.read", { n: g.entry.data.readingMinutes })}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <Newsletter lang={lang} />
    <section class="home-follow"><SocialLinks label={t(lang, "opp.follow")} center /></section>
  </div>
  <Deadlines lang={lang} />
</Base>

<style>
  .home-follow { margin-top: 40px; }
  .hero { background: radial-gradient(circle at 85% 20%, var(--brand-soft), transparent 55%), linear-gradient(180deg, #fff, var(--bg)); border-bottom: 1px solid var(--line); }
  .hero-inner { padding-block: 48px; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 32px; align-items: center; }
  .hero-copy { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; justify-items: start; min-width: 0; }
  h1 { font-size: clamp(2rem, 4.6vw, 3.2rem); font-weight: 800; color: var(--navy); max-width: 18ch; }
  .lead { margin: 0; font-size: 1.12rem; font-weight: 600; color: #1a3350; max-width: 56ch; }
  .lead .hl { color: #0a7a5a; font-weight: 800; font-size: 1.12em; white-space: nowrap; text-decoration: underline 3px #0a7a5a; text-underline-offset: 5px; text-decoration-skip-ink: none; }
  .hero-search { display: flex; gap: 8px; width: 100%; max-width: 600px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 6px; box-shadow: var(--shadow); }
  .hero-search:focus-within { border-color: var(--teal); }
  .hero-search input { flex: 1; min-width: 0; border: 0; background: transparent; padding: 10px 12px; font-size: 1rem; outline: none; }
  .hero-inner :global(.hero-logo) { width: 100%; height: auto; max-width: 420px; justify-self: center; }
  @media (max-width: 820px) { .hero-inner { grid-template-columns: minmax(0, 1fr); } .hero-inner :global(.hero-logo) { display: none; } }
  @media (max-width: 760px) {
    .hero-inner { padding-block: 22px 20px; }
    .hero-copy { gap: 10px; }
    .hero h1 { font-size: 1.65rem; max-width: none; }
    .hero .lead { font-size: 1rem; }
    .home-first { padding-top: 18px; }
    .home-first .section-head { margin-bottom: 10px; }
    .home-first .section-head h2, .home-latest .section-head h2 { font-size: 1.25rem; }
    .home-latest { padding-top: 18px; }
  }

  .section-head h2 { color: var(--navy); }
  .cats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .cat { --c: var(--teal); --g: linear-gradient(135deg, #0f8d8e, #0c2b4c); display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--line); border-inline-start: 5px solid var(--c); border-radius: 16px; box-shadow: var(--shadow); text-decoration: none; color: var(--ink); transition: transform .2s, box-shadow .2s; }
  .cat.conferences { --c: #6d4fc0; --g: linear-gradient(135deg, #6d4fc0, #2e2170); }
  .cat.exchange { --c: #2a78d1; --g: linear-gradient(135deg, #2a78d1, #0c2b4c); }
  .cat:hover { transform: translateY(-3px); box-shadow: 0 12px 26px rgb(12 43 76 / .13); }
  .cat-ico { flex: none; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; color: #fff; background: var(--g); }
  .cat-body { flex: 1; min-width: 0; display: grid; gap: 2px; }
  .cat-name { font-size: 1.05rem; font-weight: 800; color: var(--navy); line-height: 1.25; }
  .cat-count { font-size: .9rem; color: var(--muted); font-weight: 600; }
  .cat-count b { color: var(--c); font-weight: 800; }
  .cat-go { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; color: #fff; background: var(--c); }
  @media (prefers-reduced-motion: reduce) { .cat, .cat:hover { transform: none; } }
  /* Phones: categories become one swipeable row so the opportunities appear quickly. */
  @media (max-width: 760px) {
    .cats { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 10px; margin-inline: -16px; padding: 2px 16px 8px; scrollbar-width: none; }
    .cats::-webkit-scrollbar { display: none; }
    .cat { flex: 0 0 auto; width: 236px; scroll-snap-align: start; padding: 10px 12px; gap: 10px; }
    .cat-ico { width: 40px; height: 40px; }
    .cat-ico svg { width: 20px; height: 20px; }
    .cat-name { font-size: .95rem; }
    .cat-go { display: none; }
  }

  .how h2 { color: var(--navy); font-size: 1.5rem; margin-bottom: 16px; }
  .steps { list-style: none; padding: 0; margin: 0; display: flex; align-items: stretch; gap: 0; }
  .step { flex: 1 1 0; position: relative; display: grid; justify-items: center; text-align: center; gap: 8px; padding: 28px 22px 24px; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow); transition: transform .2s, box-shadow .2s; }
  .step:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgb(12 43 76 / .12); }
  .step strong { font-size: 1.2rem; color: var(--navy); }
  .step-d { color: #1a3350; font-size: 1rem; font-weight: 500; }
  .step-ico { position: relative; width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, var(--teal), var(--navy)); box-shadow: 0 8px 20px rgb(15 141 142 / .3); margin-bottom: 4px; }
  .step-n { position: absolute; top: -4px; inset-inline-end: -4px; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: #d92d20; color: #fff; font-weight: 800; font-size: .9rem; border: 3px solid var(--surface); }
  .step-arrow { flex: none; width: 76px; display: grid; place-items: center; color: var(--teal); }
  html[dir="rtl"] .step-arrow svg { transform: scaleX(-1); }
  .step-arrow .dash { stroke-dasharray: 6 6; animation: step-flow 1s linear infinite; }
  .step-arrow svg { animation: step-nudge 1.6s ease-in-out infinite; }
  html[dir="rtl"] .step-arrow svg { animation-name: step-nudge-rtl; }
  @keyframes step-flow { to { stroke-dashoffset: -12; } }
  @keyframes step-nudge { 0%, 100% { transform: translateX(-3px); } 50% { transform: translateX(4px); } }
  @keyframes step-nudge-rtl { 0%, 100% { transform: scaleX(-1) translateX(-3px); } 50% { transform: scaleX(-1) translateX(4px); } }
  @media (max-width: 760px) {
    .steps { flex-direction: column; }
    .step-arrow { width: auto; height: 56px; }
    .step-arrow svg, html[dir="rtl"] .step-arrow svg { transform: rotate(90deg); animation: none; }
  }
  @media (prefers-reduced-motion: reduce) { .step-arrow svg, .step-arrow .dash { animation: none; } }

</style>
