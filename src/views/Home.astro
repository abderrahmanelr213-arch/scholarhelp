---
import Base from "../layouts/Base.astro";
import OppCard from "../components/OppCard.astro";
import Newsletter from "../components/Newsletter.astro";
import Deadlines from "../components/Deadlines.astro";
import AdSlot from "../components/AdSlot.astro";
import { SITE, CATEGORIES } from "../site.config.mjs";
import { t, lp, type Lang } from "../i18n/ui";
import type { Opp, Guide } from "../lib/opps";
interface Props { lang: Lang; opps: Opp[]; guides: Guide[] }
const { lang, opps, guides } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const isOpen = (o: Opp) => !o.entry.data.deadline || o.entry.data.deadline.toISOString().slice(0, 10) >= today;
const open = opps.filter(isOpen);
const latest = open.slice(0, 6);
const closing = open.filter((o) => o.entry.data.deadline).sort((a, b) => +a.entry.data.deadline! - +b.entry.data.deadline!).slice(0, 3);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, open.filter((o) => o.entry.data.category === c).length]));
const fully = open.filter((o) => o.entry.data.funding === "full").length;
const countries = new Set(open.map((o) => o.countryKey)).size;
const home = new URL(lp(lang, "/"), SITE.url).href;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebSite", name: SITE.name, url: home, inLanguage: lang,
    potentialAction: { "@type": "SearchAction", target: `${new URL(lp(lang, "/opportunities/"), SITE.url).href}?q={search_term_string}`, "query-input": "required name=search_term_string" } },
  { "@context": "https://schema.org", "@type": "Organization", name: SITE.name, url: SITE.url, logo: new URL("/brand-logo.png", SITE.url).href,
    sameAs: [SITE.telegram, ...Object.values(SITE.social)].filter(Boolean) },
];
const icons: Record<string, string> = {
  scholarships: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/>',
  conferences: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  exchange: '<path d="M4 8h13l-3-3M20 16H7l3 3"/>',
};
---
<Base lang={lang} title={SITE.name} description={t(lang, "site.description")} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>{t(lang, "home.title")}</h1>
        <p class="lead">{t(lang, "home.lead")}</p>
        <form class="hero-search" role="search" action={lp(lang, "/opportunities/")} method="get">
          <label class="visually-hidden" for="hero-q">{t(lang, "home.search")}</label>
          <input id="hero-q" name="q" type="search" placeholder={t(lang, "home.search")} />
          <button class="btn" type="submit">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <span class="visually-hidden">{t(lang, "home.search")}</span>
          </button>
        </form>
        <div class="stats">
          <div><b>{open.length}</b><span>{t(lang, "home.count")}</span></div>
          <div><b>{countries}</b><span>{t(lang, "home.countries")}</span></div>
          <div><b>{fully}</b><span>{t(lang, "home.full")}</span></div>
        </div>
      </div>
      <img class="hero-logo" src="/brand-logo.png" alt="" width="534" height="360" />
    </div>
  </section>

  <div class="container">
    <section class="section">
      <div class="section-head"><h2>{t(lang, "home.browse")}</h2><a href={lp(lang, "/opportunities/")}>{t(lang, "list.viewAll")}</a></div>
      <div class="cats">
        {CATEGORIES.map((c) => (
          <a class={`cat ${c}`} href={lp(lang, `/${c}/`)}>
            <span class="cat-ico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[c]} /></span>
            <span class="cat-body">
              <strong>{t(lang, `cat.${c}` as any)}</strong>
              <span>{t(lang, `cat.${c}.desc` as any)}</span>
            </span>
            <span class="cat-count">{counts[c]}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>{t(lang, "home.latest")}</h2><a href={lp(lang, "/opportunities/?sort=new")}>{t(lang, "list.viewAll")}</a></div>
      <div class="cards">{latest.map((o) => <OppCard opp={o} lang={lang} />)}</div>
    </section>

    <AdSlot slot="" />

    {closing.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t(lang, "home.closing")}</h2><a href={lp(lang, "/opportunities/?within=30")}>{t(lang, "list.viewAll")}</a></div>
        <div class="cards">{closing.map((o) => <OppCard opp={o} lang={lang} />)}</div>
      </section>
    )}

    <section class="section how">
      <h2>{t(lang, "how.title")}</h2>
      <ol class="steps">
        {[1, 2, 3].map((n) => (
          <li><span class="step-n">{n}</span><strong>{t(lang, `how.${n}.t` as any)}</strong><span>{t(lang, `how.${n}.d` as any)}</span></li>
        ))}
      </ol>
    </section>

    {guides.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t(lang, "guides.home")}</h2><a href={lp(lang, "/guides/")}>{t(lang, "list.viewAll")}</a></div>
        <div class="guide-grid">
          {guides.slice(0, 3).map((g) => (
            <a class="guide-card" href={lp(lang, `/guides/${g.slug}/`)}>
              <span class="topic">{t(lang, `topic.${g.entry.data.topic}` as any)}</span>
              <strong>{g.entry.data.title}</strong>
              <span class="muted">{g.entry.data.summary}</span>
              <span class="read">{t(lang, "guides.read", { n: g.entry.data.readingMinutes })}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <Newsletter lang={lang} />
  </div>
  <Deadlines lang={lang} />
</Base>

<style>
  .hero { background: radial-gradient(circle at 85% 20%, var(--brand-soft), transparent 55%), linear-gradient(180deg, #fff, var(--bg)); border-bottom: 1px solid var(--line); }
  .hero-inner { padding-block: 48px; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 32px; align-items: center; }
  .hero-copy { display: grid; gap: 16px; justify-items: start; min-width: 0; }
  h1 { font-size: clamp(2rem, 4.6vw, 3.2rem); font-weight: 800; color: var(--navy); max-width: 18ch; }
  .lead { margin: 0; font-size: 1.1rem; color: var(--muted); max-width: 56ch; }
  .hero-search { display: flex; gap: 8px; width: 100%; max-width: 600px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 6px; box-shadow: var(--shadow); }
  .hero-search:focus-within { border-color: var(--teal); }
  .hero-search input { flex: 1; min-width: 0; border: 0; background: transparent; padding: 10px 12px; font-size: 1rem; outline: none; }
  .stats { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 6px; }
  .stats div { display: grid; }
  .stats b { font-size: 1.6rem; color: var(--teal); font-variant-numeric: tabular-nums; line-height: 1.1; }
  .stats span { font-size: .85rem; color: var(--muted); }
  .hero-logo { width: 100%; max-width: 420px; justify-self: center; }
  @media (max-width: 820px) { .hero-inner { grid-template-columns: 1fr; } .hero-logo { display: none; } }

  .section-head h2 { color: var(--navy); }
  .cats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 14px; }
  .cat { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: start; padding: 18px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; color: var(--ink); transition: border-color .15s, box-shadow .15s; }
  .cat:hover { box-shadow: var(--shadow); border-color: var(--teal); }
  .cat-ico { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; }
  .cat.scholarships .cat-ico { color: var(--sch); background: var(--sch-soft); }
  .cat.conferences .cat-ico { color: var(--conf); background: var(--conf-soft); }
  .cat.exchange .cat-ico { color: var(--exch); background: var(--exch-soft); }
  .cat-body { display: grid; gap: 4px; min-width: 0; }
  .cat-body span { color: var(--muted); font-size: .92rem; }
  .cat-count { font-weight: 800; color: var(--teal); font-variant-numeric: tabular-nums; font-size: 1.1rem; }

  .how h2 { color: var(--navy); font-size: 1.5rem; margin-bottom: 16px; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 14px; }
  .steps li { display: grid; gap: 6px; padding: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .steps span:not(.step-n) { color: var(--muted); font-size: .95rem; }
  .step-n { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--navy); color: #fff; font-weight: 800; }

</style>
