---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import OppCard from "../components/OppCard.astro";
import Landmark from "../components/Landmark.astro";
import Newsletter from "../components/Newsletter.astro";
import Deadlines from "../components/Deadlines.astro";
import AdSlot from "../components/AdSlot.astro";
import SocialLinks from "../components/SocialLinks.astro";
import FundingBadge from "../components/FundingBadge.astro";
import Logo from "../components/Logo.astro";
import { SITE } from "../site.config.mjs";
import { t, lp, type Lang } from "../i18n/ui";
import { isoDate, formatDate, translatedLangs, type Opp } from "../lib/opps";
interface Props { lang: Lang; opps: Opp[]; opp: Opp }
const { lang, opps, opp } = Astro.props;
const d = opp.entry.data;
const { Content } = await render(opp.entry);
const path = `/opportunities/${opp.slug}/`;
const translatedIn = await translatedLangs("opportunities", opp.slug);
const url = new URL(lp(lang, path), SITE.url).href;
const catName = t(lang, `cat.${d.category}` as any);
const related = opps.filter((o) => o.slug !== opp.slug && o.entry.data.category === d.category).slice(0, 3);
const title = d.deadline && !/\b20\d\d\b/.test(d.title) ? `${d.title} ${d.deadline.getUTCFullYear()}` : d.title;
const shareText = encodeURIComponent(`${d.title} | ${SITE.name}`);
const jsonLd = [
  {
    "@context": "https://schema.org", "@type": "Article", headline: title, description: d.summary,
    inLanguage: opp.translated ? lang : "en", datePublished: isoDate(d.published), dateModified: isoDate(d.published),
    mainEntityOfPage: url, author: { "@type": "Organization", name: SITE.name, url: SITE.url },
    publisher: { "@type": "Organization", name: SITE.name, logo: { "@type": "ImageObject", url: new URL("/brand-logo.png", SITE.url).href } },
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE.name, item: new URL(lp(lang, "/"), SITE.url).href },
      { "@type": "ListItem", position: 2, name: catName, item: new URL(lp(lang, `/${d.category}/`), SITE.url).href },
      { "@type": "ListItem", position: 3, name: d.title, item: url },
    ],
  },
];
const shortName = d.title.replace(/\s*\((fully|partially) funded\)\s*$/i, "");
// [label, text, official link]: the organisation links to its homepage, the opportunity to its official announcement.
const overview: [string, string | undefined, string?][] = [
  [t(lang, "opp.host"), d.host, d.hostUrl],
  [t(lang, "opp.location"), d.location || d.country],
  [t(lang, "opp.name"), shortName, d.officialUrl || d.link],
  [t(lang, "opp.category"), catName],
  [t(lang, "opp.levels"), d.levels.map((l) => t(lang, `level.${l}` as any)).join(", ")],
  [t(lang, "opp.duration"), d.duration],
  [t(lang, "opp.dates"), d.dates],
  [t(lang, "opp.funding"), t(lang, `funding.${d.funding}` as any)],
  [t(lang, "opp.eligible"), d.eligible],
  [t(lang, "opp.language"), d.language],
].filter(([, v]) => v);
const latest = opps.filter((o) => o.slug !== opp.slug && !related.includes(o)).slice(0, 4);
const flag = d.countryCode ? `/flags/${d.countryCode.toLowerCase()}.svg` : "";
const enc = encodeURIComponent(url);
const shares = [
  ["facebook", "Facebook", `https://www.facebook.com/sharer/sharer.php?u=${enc}`, '<path d="M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.6C16.7 2.6 15.8 2.5 14.8 2.5c-2.2 0-3.7 1.3-3.7 3.8v2.2H8.6v3.2h2.5V21h2.9v-9.3h2.5l.4-3.2z"/>'],
  ["whatsapp", "WhatsApp", `https://wa.me/?text=${shareText}%20${enc}`, '<path d="M12 2.2a9.7 9.7 0 0 0-8.4 14.6L2.2 21.8l5.1-1.3A9.7 9.7 0 1 0 12 2.2zm5.7 13.8c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-5-4.3-5.1-4.5-.1-.2-1.2-1.6-1.2-3.1s.8-2.2 1.1-2.5c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.3 0 .5l-.3.5-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.4z"/>'],
  ["telegram", "Telegram", `https://t.me/share/url?url=${enc}&text=${shareText}`, '<path d="M21.9 4.3 18.7 19.4c-.2 1.1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.2 13 1.4 11.5c-1-.3-1-1 .2-1.5L20.5 2.9c.9-.3 1.6.2 1.4 1.4z"/>'],
  ["linkedin", "LinkedIn", `https://www.linkedin.com/sharing/share-offsite/?url=${enc}`, '<path d="M4.5 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM3 8.6h3V21H3zM9 8.6h2.9v1.7c.4-.8 1.4-2 3.4-2 3.1 0 3.7 2 3.7 4.7V21h-3v-6.1c0-1.5 0-3.3-2-3.3s-2.3 1.6-2.3 3.2V21H9z"/>'],
  ["x", "X", `https://twitter.com/intent/tweet?url=${enc}&text=${shareText}`, '<path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L1.8 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z"/>'],
];
---
<Base lang={lang} title={title} description={d.summary} path={path} ogType="article" jsonLd={jsonLd} translatedIn={translatedIn}>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={lp(lang, "/")}>{t(lang, "nav.home")}</a> › <a href={lp(lang, `/${d.category}/`)}>{catName}</a> › <span>{shortName}</span>
    </nav>

    <div class="layout">
      <article class="main">
        <h1>{shortName}</h1>
        <p class="byline">
          {t(lang, "opp.by")} <strong>{t(lang, "opp.team")}</strong> · <time datetime={isoDate(d.published)}>{formatDate(d.published, lang)}</time>
          <span class={`badge ${d.category}`}>{t(lang, `cat.${d.category}.short` as any)}</span>
          <FundingBadge lang={lang} funding={d.funding} />
          <span class="closing" data-closing data-deadline-of={isoDate(d.deadline)} hidden></span>
        </p>

        <div class="banner" data-deadline={isoDate(d.deadline)}>
          <Landmark code={d.countryCode} class="banner-lm" />
          <div class="banner-art">
            {d.image ? <img class="banner-logo" src={d.image} alt={d.host || d.title} />
              : flag ? <img class="banner-flag" src={flag} alt={d.country} width="160" height="120" />
              : <svg class="banner-globe" width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>}
          </div>
          <p class="banner-title">{d.cardTitle || shortName}</p>
          <Logo variant="word" class="banner-brand" />
          <span class="banner-deadline">
            {t(lang, "opp.deadline")}: {d.deadline ? formatDate(d.deadline, lang) : t(lang, "opp.rolling")}
          </span>
        </div>

        <div class="share-row" aria-label={t(lang, "opp.share")}>
          {shares.map(([k, label, href, icon]) => (
            <a class={`sh ${k}`} href={href} target="_blank" rel="noopener" aria-label={`${t(lang, "opp.share")}: ${label}`} title={label}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icon} />
            </a>
          ))}
          <button type="button" class="sh copy" data-url={url} data-done={t(lang, "opp.copied")} title={t(lang, "opp.copy")}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
            <span>{t(lang, "opp.copy")}</span>
          </button>
          <button class="save save-inline" type="button" data-save={opp.slug} data-title={d.title} data-href={lp(lang, path)} aria-pressed="false" aria-label={t(lang, "card.save")} title={t(lang, "card.save")}>
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.3-9.4C1.4 7.6 3.7 4 7.2 4c2 0 3.6 1.1 4.8 2.8C13.2 5.1 14.8 4 16.8 4c3.5 0 5.8 3.6 4.5 7.1-1.8 4.8-9.3 9.4-9.3 9.4z"/></svg>
          </button>
        </div>

        <p class="intro">{d.summary}</p>
        {d.language && <p class="lang-req"><strong>{t(lang, "opp.language")}:</strong> {d.language}</p>}
        {!opp.translated && <p class="note">{t(lang, "opp.untranslated")}</p>}
        {d.sample && <p class="note warn">{t(lang, "opp.sample")}</p>}

        <AdSlot slot="" />

        <div class="prose" lang={opp.translated ? lang : "en"} dir={opp.translated ? undefined : "ltr"}>
          <Content />
          {d.fee && (<><h2>{t(lang, "opp.fee")}</h2><p>{d.fee}</p></>)}
        </div>

        <section class="overview" data-deadline={isoDate(d.deadline)}>
          <h2>{t(lang, "opp.overview")}</h2>
          <ul>
            {overview.map(([k, v, href]) => (
              <li><strong>{k}:</strong> {k === t(lang, "opp.location") && flag
                ? <span class="loc"><img src={flag} alt="" width="24" height="18" />{v}</span>
                : href ? <a class="official" href={href} target="_blank" rel="noopener nofollow" data-gate>{v}<svg class="flip-rtl" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a>
                : v}</li>
            ))}
            <li class="dl"><strong>{t(lang, "opp.deadline")}: {d.deadline ? <time datetime={isoDate(d.deadline)}>{formatDate(d.deadline, lang)}</time> : t(lang, "opp.rolling")}</strong> <span class="left" data-left hidden></span></li>
            {d.deadlineNote && <li class="dl">{d.deadlineNote}</li>}
          </ul>
        </section>

        <a class="btn apply-big" href={d.link} target="_blank" rel="noopener nofollow" data-gate>{t(lang, "opp.applyNow")} ↗</a>
        <p class="apply-note">{t(lang, "opp.applyNote")}</p>

        <p class="disclaimer"><strong>{t(lang, "opp.disclaimerTitle")}:</strong> {t(lang, "opp.disclaimer")}</p>

        <div class="follow"><SocialLinks label={t(lang, "opp.follow")} center /></div>
      </article>

      <aside class="side" aria-label={t(lang, "opp.details")}>
        <div class="facts-box" data-deadline={isoDate(d.deadline)}>
          <div class="fact deadline">
            <span class="label">{t(lang, "opp.deadline")}</span>
            <strong>{d.deadline ? formatDate(d.deadline, lang) : t(lang, "opp.rolling")}</strong>
            <span class="left" data-left hidden></span>
          </div>
          <dl>
            {d.host && <div><dt>{t(lang, "opp.host")}</dt><dd>{d.host}</dd></div>}
            <div><dt>{t(lang, "opp.funding")}</dt><dd>{t(lang, `funding.${d.funding}` as any)}</dd></div>
          </dl>
        </div>
        {latest.length > 0 && (
          <div class="latest">
            <h2>{t(lang, "opp.latest")}</h2>
            <ul>
              {latest.map((o) => (
                <li><a href={lp(lang, `/opportunities/${o.slug}/`)}>
                  {o.entry.data.countryCode ? <img src={`/flags/${o.entry.data.countryCode.toLowerCase()}.svg`} alt="" width="40" height="30" loading="lazy" /> : <span class="globe">🌐</span>}
                  <span>{o.entry.data.title.replace(/\s*\((fully|partially) funded\)\s*$/i, "")}</span>
                </a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>

    {related.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>{t(lang, "opp.related")}</h2><a href={lp(lang, `/${d.category}/`)}>{t(lang, "list.viewAll")}</a></div>
        <div class="cards">{related.map((o) => <OppCard opp={o} lang={lang} />)}</div>
      </section>
    )}

    <Newsletter lang={lang} />
  </div>
  <Deadlines lang={lang} />
  <script>
    document.querySelectorAll<HTMLButtonElement>(".copy").forEach((b) => b.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(b.dataset.url || location.href); const s = b.querySelector("span"); if (s) s.textContent = b.dataset.done || "Copied"; } catch {}
    }));
  </script>
</Base>

<style>
  .crumbs { padding-top: 20px; font-size: .9rem; color: var(--muted); }
  .crumbs a { color: var(--muted); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 40px; align-items: start; padding-top: 12px; }
  .main { min-width: 0; max-width: 760px; }
  h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); font-weight: 800; color: var(--navy); }
  .byline { margin: 10px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; color: var(--muted); font-size: .92rem; }
  .byline strong { color: var(--ink); }
  .banner { position: relative; margin-top: 18px; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: radial-gradient(circle at 80% 15%, rgb(15 141 142 / .14), transparent 60%), linear-gradient(180deg, #fff, #eef6f7); border: 1px solid var(--line); display: grid; grid-template-rows: 1fr auto auto; justify-items: center; align-items: center; padding: 22px 22px 54px; text-align: center; }
  :global(.banner-lm) { position: absolute; bottom: 48px; inset-inline-end: 4%; width: 26%; height: calc(100% - 62px); color: var(--teal); opacity: .24; pointer-events: none; }
  :global(.banner-lm.wide) { width: 32%; opacity: .18; }
  :global(.banner-lm.center) { inset-inline: 0; margin-inline: auto; width: 100%; opacity: .2; }
  .banner-art, .banner-title, :global(.banner-brand) { position: relative; z-index: 1; }
  .banner-art { display: grid; place-items: center; min-height: 0; }
  .banner-flag { width: clamp(110px, 24vw, 170px); height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; box-shadow: 0 6px 20px rgb(12 43 76 / .22); }
  .banner-logo { max-height: clamp(80px, 18vw, 140px); max-width: 70%; object-fit: contain; }
  .banner-globe { color: var(--teal); }
  .banner-title { margin: 14px 0 6px; font-weight: 800; color: var(--navy); font-size: clamp(1rem, 2.6vw, 1.45rem); line-height: 1.25; max-width: 30ch; }
  :global(.banner-brand) { height: 20px; width: auto; }
  .banner-deadline { position: absolute; inset-inline: 0; bottom: 0; padding: 10px; background: var(--navy); color: #fff; font-weight: 800; font-size: clamp(.9rem, 2.2vw, 1.05rem); }
  .share-row { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .sh { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-width: 46px; height: 38px; padding: 0 12px; border-radius: 8px; color: #fff; border: 0; cursor: pointer; text-decoration: none; font-weight: 700; font-size: .88rem; }
  .sh.facebook { background: #1877f2; } .sh.whatsapp { background: #25d366; } .sh.telegram { background: #229ed9; }
  .sh.linkedin { background: #0a66c2; } .sh.x { background: #000; } .sh.copy { background: var(--surface-2); color: var(--ink); border: 1px solid var(--line); }
  .sh:hover { filter: brightness(.92); }
  .save-inline { position: static; width: 40px; height: 38px; border-radius: 8px; margin-inline-start: auto; }
  .intro { margin: 20px 0 0; font-size: 1.08rem; line-height: 1.75; }
  .note { margin: 16px 0 0; padding: 10px 14px; border-radius: 10px; background: var(--surface-2); color: var(--muted); font-size: .92rem; }
  .note.warn { background: var(--gold-soft); color: var(--gold); }
  .lang-req { margin: 12px 0 0; padding: 10px 14px; border-radius: 10px; background: #fff7e6; border: 1px solid #f0c36d; color: #4a3200; line-height: 1.55; }
  .lang-req strong { color: #7a4b00; }
  .overview { margin-top: 32px; padding: 18px 22px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); border-inline-start: 4px solid var(--teal); }
  .overview h2 { font-size: 1.35rem; color: var(--navy); margin: 0 0 10px; }
  .overview ul { margin: 0; padding-inline-start: 20px; display: grid; gap: 8px; line-height: 1.6; }
  .overview .dl { color: var(--danger); }
  .overview .official { color: var(--brand); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .overview .official svg { display: inline; vertical-align: -1px; margin-inline-start: 4px; }
  .overview .official:hover { color: var(--navy); }
  .loc { display: inline-flex; align-items: center; gap: 7px; vertical-align: bottom; }
  .loc img { width: 24px; height: 18px; object-fit: cover; border-radius: 3px; box-shadow: 0 0 0 1px rgb(0 0 0 / .1); }
  .overview .dl .left { margin-inline-start: 6px; }
  .prose { margin-top: 8px; }
  .prose :global(h2) { color: var(--navy); }
  .apply-big { display: flex; width: fit-content; margin: 28px auto 0; padding: 12px 28px; font-size: 1.05rem; background: #e8590c; }
  .apply-big:hover { background: #c94a06; }
  .apply-note { margin: 10px 0 0; color: var(--ink); font-size: .95rem; font-weight: 600; text-align: center; }
  .disclaimer { margin-top: 24px; padding: 14px 16px; border-radius: 10px; background: var(--surface-2); line-height: 1.7; font-size: 1rem; color: var(--ink); }
  .follow { margin-top: 24px; text-align: center; }
  .side { position: sticky; top: 84px; display: grid; gap: 18px; }
  .label { font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; }
  html[dir="rtl"] .label { text-transform: none; letter-spacing: 0; }
  .facts-box { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; display: grid; gap: 14px; box-shadow: var(--shadow); }
  .fact.deadline { display: grid; gap: 4px; justify-items: start; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .fact.deadline strong { font-size: 1.15rem; color: var(--danger); }
  dl { margin: 0; display: grid; gap: 10px; }
  dl div { display: grid; gap: 2px; }
  dt { font-size: .8rem; color: var(--muted); font-weight: 600; }
  dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .latest h2 { font-size: 1rem; color: #fff; background: var(--teal); display: inline-block; padding: 6px 12px; border-radius: 6px 6px 0 0; margin: 0; }
  .latest ul { list-style: none; margin: 0; padding: 12px 0 0; border-top: 2px solid var(--teal); display: grid; gap: 12px; }
  .latest a { display: grid; grid-template-columns: 40px 1fr; gap: 10px; align-items: start; text-decoration: none; color: var(--ink); font-weight: 600; font-size: .92rem; line-height: 1.35; }
  .latest a:hover span { color: var(--brand); }
  .latest img { width: 40px; height: 30px; object-fit: cover; border-radius: 4px; box-shadow: 0 1px 3px rgb(0 0 0 / .2); }
  .latest .globe { font-size: 1.4rem; text-align: center; }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .side { position: static; }
    .facts-box { display: none; }
  }
</style>
