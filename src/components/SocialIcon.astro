---
// Official-looking app icons for Telegram and Instagram, in their brand colors.
interface Props { name: "telegram" | "instagram" | "facebook" | "youtube" | "tiktok" | "linktree"; size?: number; glyph?: boolean }
// glyph: Instagram as the gradient camera outline only (for round white buttons).
const { name, size = 22, glyph = false } = Astro.props;
const id = `${name}-${Math.random().toString(36).slice(2, 8)}`;
---
{name === "facebook" ? (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class="social-icon">
    <circle cx="12" cy="12" r="12" fill="#0866FF" />
    <path fill="#fff" d="M15.1 24v-8.7h2.9l.4-3.4h-3.3V9.8c0-1 .3-1.6 1.7-1.6h1.8v-3a24 24 0 0 0-2.6-.1c-2.6 0-4.4 1.6-4.4 4.5v2.4H8.7v3.4h2.9V24z" />
  </svg>
) : name === "youtube" ? (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class="social-icon">
    <rect x="0.5" y="4" width="23" height="16" rx="4.6" fill="#FF0000" />
    <path fill="#fff" d="M9.6 8.4v7.2l6.2-3.6z" />
  </svg>
) : name === "tiktok" ? (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class="social-icon">
    <path fill="#25F4EE" d="M9.4 9.6v-1a7.4 7.4 0 0 0-1-.1 7.3 7.3 0 0 0-4.2 13.3A7.3 7.3 0 0 1 9.4 9.6z" />
    <path fill="#25F4EE" d="M9.6 21.2a3.3 3.3 0 0 0 3.3-3.2V2.2h2.9a5.6 5.6 0 0 1-.1-1h-4v15.8a3.3 3.3 0 0 1-3.3 3.2 3.4 3.4 0 0 1-1.5-.4 3.3 3.3 0 0 0 2.7 1.4zM21.2 7.6V6.7a5.4 5.4 0 0 1-3-.9 5.5 5.5 0 0 0 3 1.8z" />
    <path fill="#FE2C55" d="M18.2 5.8a5.5 5.5 0 0 1-1.4-3.6h-1a5.6 5.6 0 0 0 2.4 3.6zM8.4 13.6a3.3 3.3 0 0 0-1.5 6.2 3.3 3.3 0 0 1 3.7-5.3v-4a7.4 7.4 0 0 0-1-.1h-.2v3a3.4 3.4 0 0 0-1-.2zM21.2 7.6v3a9.4 9.4 0 0 1-5.4-1.7v7.8a7.2 7.2 0 0 1-11.4 5.9 7.3 7.3 0 0 0 12.4-5.2V9.6a9.4 9.4 0 0 0 5.4 1.7V7.8a5.6 5.6 0 0 1-1-.2z" />
    <path fill="#000" d="M15.8 16.7V8.9a9.4 9.4 0 0 0 5.4 1.7v-3a5.5 5.5 0 0 1-3-1.8 5.5 5.5 0 0 1-2.4-3.6h-2.9V18a3.3 3.3 0 0 1-6 1.8 3.3 3.3 0 0 1 1.5-6.2 3.4 3.4 0 0 1 1 .2v-3a7.3 7.3 0 0 0-5 12.4 7.2 7.2 0 0 0 11.4-5.9z" />
  </svg>
) : name === "linktree" ? (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class="social-icon">
    <circle cx="12" cy="12" r="12" fill="#43E55E" />
    <path fill="none" stroke="#0C0C0C" stroke-width="2.3" stroke-linecap="square" d="M12 4.6v6.2M5.4 10.8h13.2M7.5 6.2 12 10.8l4.5-4.6M7.5 15.3 12 10.8l4.5 4.5M12 14.6v5.2" />
  </svg>
) : name === "telegram" ? (
  <svg width={size} height={size} viewBox="0 0 240 240" aria-hidden="true" class="social-icon">
    <defs><linearGradient id={id} x1="120" y1="0" x2="120" y2="240" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#2AABEE" /><stop offset="1" stop-color="#229ED9" /></linearGradient></defs>
    <circle cx="120" cy="120" r="120" fill={`url(#${id})`} />
    <path fill="#fff" d="M54.3 118.8c35-15.2 58.3-25.3 70-30.2 33.3-13.9 40.3-16.3 44.8-16.4 1 0 3.2.2 4.7 1.4 1.2 1 1.5 2.3 1.7 3.3s.4 3.1.2 4.7c-1.8 19-9.6 65.1-13.6 86.3-1.7 9-5 12-8.2 12.3-7 .6-12.3-4.6-19-9-10.6-6.9-16.5-11.2-26.8-18-11.9-7.8-4.2-12.1 2.6-19.1 1.8-1.8 32.5-29.8 33.1-32.3.1-.3.1-1.5-.6-2.1-.7-.6-1.7-.4-2.5-.2-1.1.2-17.9 11.4-50.6 33.5-4.8 3.3-9.1 4.9-13 4.8-4.3-.1-12.5-2.4-18.7-4.4-7.5-2.4-13.5-3.7-13-7.9.3-2.2 3.3-4.4 8.9-6.7z" />
  </svg>
) : glyph ? (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class="social-icon">
    <defs><radialGradient id={id} cx="6" cy="24" r="26" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#FFDD55" /><stop offset=".12" stop-color="#FFDD55" /><stop offset=".5" stop-color="#FF543E" /><stop offset="1" stop-color="#C837AB" /></radialGradient></defs>
    <g fill="none" stroke={`url(#${id})`} stroke-width="2.3"><rect x="2.5" y="2.5" width="19" height="19" rx="5.6" /><circle cx="12" cy="12" r="4.4" /></g>
    <circle cx="17.6" cy="6.4" r="1.4" fill={`url(#${id})`} />
  </svg>
) : (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class="social-icon">
    <defs><radialGradient id={id} cx="6.5" cy="25.8" r="27" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#FFDD55" /><stop offset=".1" stop-color="#FFDD55" /><stop offset=".5" stop-color="#FF543E" /><stop offset="1" stop-color="#C837AB" /></radialGradient></defs>
    <rect width="24" height="24" rx="6" fill={`url(#${id})`} />
    <rect x="5" y="5" width="14" height="14" rx="4.2" fill="none" stroke="#fff" stroke-width="1.8" />
    <circle cx="12" cy="12" r="3.4" fill="none" stroke="#fff" stroke-width="1.8" />
    <circle cx="16.3" cy="7.7" r="1.05" fill="#fff" />
  </svg>
)}
<style>.social-icon { flex: none; display: block; }</style>
