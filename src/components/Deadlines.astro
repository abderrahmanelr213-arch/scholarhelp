---
// Fills every [data-left] badge with "N days left" in the visitor's language, and marks closed cards.
import { t, type Lang } from "../i18n/ui";
const { lang } = Astro.props as { lang: Lang };
const strings = { closed: t(lang, "opp.closed"), today: t(lang, "opp.today"), many: t(lang, "opp.daysLeft"), one: t(lang, "opp.dayLeft") };
---
<script is:inline define:vars={{ strings }}>
  window.__shDays = function (iso) {
    if (!iso) return null;
    var now = new Date(); now.setHours(0, 0, 0, 0);
    return Math.round((new Date(iso + "T00:00:00") - now) / 86400000);
  };
  window.__shLabel = function (el, iso) {
    var d = window.__shDays(iso);
    if (d === null) { el.hidden = true; return; }
    el.hidden = false;
    el.className = "left" + (d < 0 ? " closed" : d <= 30 ? " soon" : "");
    el.textContent = d < 0 ? strings.closed : d === 0 ? strings.today : d === 1 ? strings.one : strings.many.replace("{n}", d);
  };
  document.querySelectorAll("[data-new-badge]").forEach(function (el) {
    var host = el.closest("[data-published]");
    var p = host && host.getAttribute("data-published");
    if (p && (Date.now() - new Date(p + "T00:00:00")) < 7 * 86400000) el.hidden = false;
  });
  document.querySelectorAll("[data-left]").forEach(function (el) {
    var host = el.closest("[data-deadline]");
    window.__shLabel(el, host ? host.getAttribute("data-deadline") : "");
  });
  document.querySelectorAll(".card[data-deadline]").forEach(function (card) {
    if (window.__shDays(card.getAttribute("data-deadline")) < 0) card.classList.add("is-closed");
  });
</script>
