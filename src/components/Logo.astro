---
{variant === "icon" && <svg class:list={["sh-logo", cls, { anim: animate }]} viewBox="468 122 600 525" {...a11y} set:html={ICON} />}
{variant === "word" && <svg class:list={["sh-logo", cls]} viewBox="222 670 1098 200" {...a11y} set:html={WORD} />}
{variant === "row" && (
  <span class:list={["sh-logo-row", cls]} {...a11y}>
    <svg class:list={["sh-logo", "i", { anim: animate }]} viewBox="468 122 600 525" set:html={ICON} />
    <svg class="sh-logo w" viewBox="222 670 1098 200" set:html={WORD} />
  </span>
)}
{variant === "stacked" && <svg class:list={["sh-logo", cls, { anim: animate }]} viewBox="215 115 1110 760" {...a11y} set:html={ICON + WORD} />}

<style is:global>
  .sh-logo { display: block; overflow: visible; }
  .sh-logo-row { display: inline-flex; align-items: center; gap: .3em; }
  .sh-logo .tassel { transform-box: view-box; transform-origin: 1023px 292px; }
  .sh-logo .dot { transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .sh-logo.anim .dot { animation: sh-type 2.4s ease-in-out infinite; }
    .sh-logo.anim .d1 { animation-delay: .15s; }
    .sh-logo.anim .d2 { animation-delay: .3s; }
    .sh-logo.anim .tassel { animation: sh-swing 4.8s ease-in-out infinite; }
    a:hover > .sh-logo.anim .tassel, a:hover .sh-logo-row .anim .tassel { animation-duration: 1.2s; }
  }
  @keyframes sh-type { 0%, 40%, 100% { transform: translateY(0); opacity: 1; } 15% { transform: translateY(-22%); opacity: .55; } }
  @keyframes sh-swing { 0%, 70%, 100% { transform: rotate(0); } 77% { transform: rotate(9deg); } 85% { transform: rotate(-6deg); } 92% { transform: rotate(3deg); } }
</style>
