---
// Registration pop-up (name, email, optional phone) that comes back during a visit.
// First shown after 20 seconds or 40% scroll; after "Maybe later" it returns 2 minutes later
// (or on the next page), up to 3 times per visit. On desktop it also opens when the mouse heads
// for the browser tabs (exit intent). Once someone registers it never shows again.
// Saved to the Supabase `subscribers` table; no password, no email is sent.
import { SITE } from "../site.config.mjs";
import SocialIcon from "./SocialIcon.astro";
import { t, type Lang } from "../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<div class="reg" data-reg data-lang={lang} data-ok={t(lang, "reg.ok")} data-err={t(lang, "reg.err")} data-fail={t(lang, "reg.fail")} hidden>
  <div class="reg-shade" data-reg-close></div>
  <div class="reg-card" role="dialog" aria-modal="true" aria-labelledby={`reg-title-${lang}`}>
    <button class="reg-close" type="button" data-reg-close aria-label={t(lang, "reg.close")}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <span class="reg-ico" aria-hidden="true">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg>
    </span>
    <p class="reg-title" id={`reg-title-${lang}`}>{t(lang, "reg.title")}</p>
    <p class="reg-lead">{t(lang, "reg.lead")}</p>
    <form data-reg-form novalidate>
      <label class="visually-hidden" for={`reg-name-${lang}`}>{t(lang, "reg.name")}</label>
      <input id={`reg-name-${lang}`} name="name" type="text" required autocomplete="name" maxlength="80" placeholder={t(lang, "reg.name")} />
      <label class="visually-hidden" for={`reg-email-${lang}`}>{t(lang, "reg.email")}</label>
      <input id={`reg-email-${lang}`} name="email" type="email" required autocomplete="email" placeholder={t(lang, "reg.email")} />
      <div class="reg-phone" dir="ltr" data-phone>
        <button class="reg-cc" type="button" data-cc-btn aria-haspopup="listbox" aria-expanded="false" aria-label={t(lang, "reg.country")}>
          <img data-cc-flag src="/flags/un.svg" alt="" width="24" height="18" hidden />
          <svg data-cc-globe width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></svg>
          <span data-cc-code>+</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <label class="visually-hidden" for={`reg-phone-${lang}`}>{t(lang, "reg.phone")}</label>
        <input id={`reg-phone-${lang}`} name="phone" type="tel" required autocomplete="tel-national" inputmode="tel" maxlength="20" placeholder={t(lang, "reg.phone")} />
        <div class="reg-cc-list" data-cc-panel dir={lang === "en" ? "ltr" : "rtl"} hidden>
          <input type="search" data-cc-search placeholder={t(lang, "reg.search")} aria-label={t(lang, "reg.search")} dir="auto" />
          <ul role="listbox" data-cc-items></ul>
        </div>
      </div>
      <button class="btn reg-submit" type="submit">{t(lang, "reg.submit")}</button>
    </form>
    <p class="reg-msg" data-reg-msg role="status" hidden></p>
    <a class="reg-tg" href={SITE.telegram} target="_blank" rel="noopener">
      <SocialIcon name="telegram" size={26} />
      <span>{t(lang, "reg.tg")}</span>
    </a>
    <button class="reg-later" type="button" data-reg-close>{t(lang, "reg.later")}</button>
  </div>
</div>

<script>
  import { getSupabase } from "../lib/client/supabase";
  import { DIAL } from "../lib/dial-codes";
  // No limit per visit: it keeps coming back until the visitor registers.
  const MAX_PER_VISIT = Infinity, FIRST_DELAY = 20e3, AGAIN_AFTER = 120e3;
  // localStorage remembers a registration for good; sessionStorage counts pop-ups in this visit.
  const read = (s: Storage, k: string) => { try { return JSON.parse(s.getItem(k) || "{}"); } catch { return {}; } };
  const write = (s: Storage, k: string, v: object) => { try { s.setItem(k, JSON.stringify({ ...read(s, k), ...v })); } catch {} };
  const done = () => !!read(localStorage, "sh-reg").done;
  const visit = () => read(sessionStorage, "sh-reg-visit") as { shown?: number; closed?: number };

  const box = document.querySelector<HTMLElement>("[data-reg]");
  if (box) {
    let timer = 0;
    const isOpen = () => !box.hidden;
    const open = (auto: boolean) => {
      if (isOpen() || done()) return;
      if (auto) {
        const v = visit();
        if ((v.shown || 0) >= MAX_PER_VISIT) return;
        write(sessionStorage, "sh-reg-visit", { shown: (v.shown || 0) + 1 });
      }
      clearTimeout(timer);
      box.hidden = false;
      document.documentElement.classList.add("reg-open");
      if (innerWidth > 720) box.querySelector<HTMLInputElement>("input")?.focus({ preventScroll: true });
    };
    // The link or button the visitor clicked before the pop-up appeared; it runs once they close or register.
    let pending: HTMLElement | null = null, replaying = false;
    const proceed = () => {
      const el = pending; pending = null;
      if (!el || !el.isConnected) return;
      replaying = true;
      try { el.click(); } finally { replaying = false; }
    };
    const close = () => {
      box.hidden = true;
      document.documentElement.classList.remove("reg-open");
      write(sessionStorage, "sh-reg-visit", { closed: Date.now() });
      schedule(AGAIN_AFTER);
      proceed();
    };
    // Plan the next automatic pop-up.
    const schedule = (delay: number) => {
      clearTimeout(timer);
      if (done() || (visit().shown || 0) >= MAX_PER_VISIT) return;
      timer = window.setTimeout(() => open(true), delay);
    };

    if (!done()) {
      const v = visit();
      // First pop-up of the visit: after 20 s or 40% scroll. Later ones: 2 minutes after the last close,
      // or straight away on a new page if that time has already passed.
      const wait = v.closed ? Math.max(3e3, AGAIN_AFTER - (Date.now() - v.closed)) : FIRST_DELAY;
      schedule(wait);
      if (!v.shown) {
        const onScroll = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          if (max > 0 && scrollY / max >= 0.4) { removeEventListener("scroll", onScroll); open(true); }
        };
        addEventListener("scroll", onScroll, { passive: true });
      }
      // Desktop exit intent: the mouse leaves through the top of the window.
      if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
        document.addEventListener("mouseout", (e) => {
          if (!e.relatedTarget && e.clientY <= 0) {
            const c = visit().closed;
            if (!c || Date.now() - c > 30e3) open(true);
          }
        });
      }
    }

    // The header "Register" button always opens it.
    document.querySelectorAll<HTMLAnchorElement>("[data-reg-trigger]").forEach((a) => a.addEventListener("click", (e) => {
      if (done()) return;
      e.preventDefault(); open(false);
    }));
    // Any click on a link or button shows the pop-up first, until the visitor registers.
    // Closing it is always possible, and the click then goes ahead as normal.
    document.addEventListener("click", (e) => {
      if (replaying || done() || isOpen() || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
      const el = (e.target as HTMLElement).closest<HTMLElement>("a[href], button");
      if (!el || box.contains(el) || el.matches("[data-reg-trigger]")) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      pending = el;
      open(false);
    }, true);
    box.querySelectorAll("[data-reg-close]").forEach((b) => b.addEventListener("click", close));
    addEventListener("keydown", (e) => { if (e.key === "Escape" && isOpen()) close(); });

    // Country code picker: flag + dialing code, names in the page language, searchable.
    const phone = box.querySelector<HTMLElement>("[data-phone]")!;
    const ccBtn = phone.querySelector<HTMLButtonElement>("[data-cc-btn]")!;
    const panel = phone.querySelector<HTMLElement>("[data-cc-panel]")!;
    const search = phone.querySelector<HTMLInputElement>("[data-cc-search]")!;
    const list = phone.querySelector<HTMLElement>("[data-cc-items]")!;
    const lang = box.dataset.lang || "en";
    let names: Intl.DisplayNames | null = null;
    try { names = new Intl.DisplayNames([lang, "en"], { type: "region" }); } catch {}
    const countries = DIAL.split(",").map((p) => { const [iso, code] = p.split(":"); return { iso, code, name: names?.of(iso) || iso }; })
      .sort((a, b) => a.name.localeCompare(b.name, lang));
    let cc = "";
    const pick = (iso: string) => {
      const c = countries.find((x) => x.iso === iso); if (!c) return;
      cc = c.code;
      const flag = phone.querySelector<HTMLImageElement>("[data-cc-flag]")!;
      flag.src = `/flags/${iso.toLowerCase()}.svg`; flag.alt = c.name; flag.hidden = false;
      phone.querySelector<SVGElement>("[data-cc-globe]")!.style.display = "none";
      phone.querySelector("[data-cc-code]")!.textContent = "+" + c.code;
    };
    // Guess the visitor's country from their time zone, then their browser language.
    const TZ: Record<string, string> = { Algiers: "DZ", Kabul: "AF", Cairo: "EG", Casablanca: "MA", Tunis: "TN", Tripoli: "LY", Khartoum: "SD", Riyadh: "SA", Baghdad: "IQ", Amman: "JO", Beirut: "LB", Damascus: "SY", Dubai: "AE", Muscat: "OM", Qatar: "QA", Kuwait: "KW", Bahrain: "BH", Aden: "YE", Gaza: "PS", Hebron: "PS", Nouakchott: "MR", Karachi: "PK", Tehran: "IR", Istanbul: "TR", Kolkata: "IN", Calcutta: "IN", Dhaka: "BD", Jakarta: "ID", Kuala_Lumpur: "MY", Lagos: "NG", Nairobi: "KE", Accra: "GH", Addis_Ababa: "ET", Mogadishu: "SO", Dakar: "SN", Tashkent: "UZ", Dushanbe: "TJ", London: "GB", Paris: "FR", Berlin: "DE", Madrid: "ES", Rome: "IT" };
    const guess = () => {
      try { const z = Intl.DateTimeFormat().resolvedOptions().timeZone.split("/").pop()!; if (TZ[z]) return TZ[z]; } catch {}
      for (const l of navigator.languages || []) { const r = l.split("-")[1]; if (r && r.length === 2 && countries.some((c) => c.iso === r.toUpperCase())) return r.toUpperCase(); }
      return lang === "ps" ? "AF" : "";
    };
    const g = guess(); if (g) pick(g);
    const render = (q: string) => {
      const n = q.trim().toLowerCase().replace(/^\+/, "");
      list.innerHTML = "";
      countries.filter((c) => !n || c.name.toLowerCase().includes(n) || c.code.startsWith(n) || c.iso.toLowerCase() === n).forEach((c) => {
        const li = document.createElement("li");
        li.setAttribute("role", "option"); li.tabIndex = 0; li.dataset.iso = c.iso;
        li.innerHTML = `<img src="/flags/${c.iso.toLowerCase()}.svg" alt="" width="22" height="16" loading="lazy"><span dir="auto"></span><b>+${c.code}</b>`;
        li.querySelector("span")!.textContent = c.name;
        list.append(li);
      });
    };
    const togglePanel = (show: boolean) => {
      panel.hidden = !show; ccBtn.setAttribute("aria-expanded", String(show));
      if (show) { search.value = ""; render(""); search.focus(); }
    };
    ccBtn.addEventListener("click", () => togglePanel(panel.hidden));
    search.addEventListener("input", () => render(search.value));
    const choose = (e: Event) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>("li[data-iso]"); if (!li) return;
      pick(li.dataset.iso!); togglePanel(false); phone.querySelector<HTMLInputElement>("input[name=phone]")!.focus();
    };
    list.addEventListener("click", choose);
    list.addEventListener("keydown", (e) => { if (e.key === "Enter") choose(e); });
    search.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); (list.firstElementChild as HTMLElement)?.click(); } });
    document.addEventListener("click", (e) => { if (!panel.hidden && !phone.contains(e.target as Node)) togglePanel(false); });
    // Typing a number that starts with + picks the country automatically.
    phone.querySelector<HTMLInputElement>("input[name=phone]")!.addEventListener("input", (e) => {
      const v = (e.target as HTMLInputElement).value.replace(/[^\d+]/g, "");
      if (!v.startsWith("+")) return;
      const d = v.slice(1);
      const hit = [...countries].sort((a, b) => b.code.length - a.code.length).find((c) => d.startsWith(c.code));
      if (hit && hit.code !== cc) pick(hit.iso);
    });

    const form = box.querySelector<HTMLFormElement>("[data-reg-form]")!;
    const msg = box.querySelector<HTMLElement>("[data-reg-msg]")!;
    const show = (text: string, ok: boolean) => { msg.hidden = false; msg.textContent = text; msg.classList.toggle("bad", !ok); };
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement).value.trim();
      const name = val("name"), email = val("email").toLowerCase();
      // Store the full international number, e.g. +213555123456.
      let local = val("phone").replace(/[^\d+]/g, "");
      if (local.startsWith("+")) local = local.slice(1).startsWith(cc) ? local.slice(1 + cc.length) : "";
      local = local.replace(/\D/g, "").replace(/^0+/, "");
      const fullPhone = cc && local.length >= 6 && local.length <= 14 ? `+${cc}${local}` : "";
      if (!name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) || !fullPhone) return show(box.dataset.err!, false);
      const btn = form.querySelector<HTMLButtonElement>(".reg-submit")!; btn.disabled = true;
      const sb = await getSupabase();
      const row = { name, email, phone: fullPhone, lang: box.dataset.lang };
      const { error } = sb ? await sb.from("subscribers").insert(row) : { error: { code: "off" } as any };
      btn.disabled = false;
      // A duplicate email means they are already registered, which is fine.
      if (error && error.code !== "23505") return show(box.dataset.fail!, false);
      write(localStorage, "sh-reg", { done: Date.now() });
      clearTimeout(timer);
      form.hidden = true;
      show(box.dataset.ok!.replace("{name}", name.split(" ")[0]), true);
      setTimeout(() => { box.hidden = true; document.documentElement.classList.remove("reg-open"); proceed(); }, pending ? 1800 : 3500);
    });
  }
</script>

<style>
  .reg { position: fixed; inset: 0; z-index: 80; display: grid; place-items: center; padding: 16px; }
  .reg[hidden] { display: none; }
  .reg-shade { position: absolute; inset: 0; background: rgb(6 24 44 / .55); backdrop-filter: blur(2px); animation: reg-fade .25s ease-out; }
  .reg-card { position: relative; width: 100%; max-width: 420px; max-height: calc(100dvh - 32px); overflow: auto; background: var(--surface); border-top: 6px solid #d92d20; border-radius: 20px; padding: 26px 24px 18px; box-shadow: 0 24px 60px rgb(6 24 44 / .4); display: grid; gap: 10px; text-align: center; animation: reg-pop .35s cubic-bezier(.2, 1.4, .4, 1); }
  @keyframes reg-fade { from { opacity: 0; } }
  @keyframes reg-pop { from { transform: scale(.85) translateY(20px); opacity: 0; } }
  .reg-close { position: absolute; top: 10px; inset-inline-end: 10px; width: 36px; height: 36px; border-radius: 50%; border: 0; background: var(--surface-2); color: var(--ink); cursor: pointer; display: grid; place-items: center; }
  .reg-close:hover { background: var(--line); }
  .reg-ico { justify-self: center; width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, var(--teal), var(--navy)); box-shadow: 0 8px 20px rgb(15 141 142 / .3); }
  .reg-title { margin: 0; font-weight: 800; font-size: 1.45rem; color: var(--navy); }
  .reg-lead { margin: 0 0 4px; color: var(--muted); font-size: .98rem; line-height: 1.5; }
  .reg form { display: grid; gap: 10px; }
  .reg form[hidden] { display: none; }
  .reg input { width: 100%; padding: 13px 14px; border-radius: 12px; border: 1px solid var(--line); background: #fff; color: var(--ink); font: inherit; font-size: 1rem; text-align: start; }
  .reg-phone { display: flex; flex-wrap: wrap; gap: 8px; }
  .reg-phone input[type="tel"] { flex: 1; min-width: 0; text-align: left; }
  .reg-cc { flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 0 10px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface-2); color: var(--ink); font: inherit; font-weight: 700; cursor: pointer; }
  .reg-cc img { border-radius: 3px; box-shadow: 0 0 0 1px rgb(12 43 76 / .12); object-fit: cover; }
  .reg-cc:focus-visible { outline: 2px solid var(--teal); }
  .reg-cc-list { flex: 0 0 100%; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 16px 40px rgb(6 24 44 / .25); padding: 8px; display: grid; gap: 6px; }
  .reg-cc-list[hidden] { display: none; }
  .reg-cc-list ul { list-style: none; margin: 0; padding: 0; max-height: 200px; overflow: auto; text-align: start; }
  .reg-cc-list :global(li) { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; cursor: pointer; font-size: .95rem; }
  .reg-cc-list :global(li:hover), .reg-cc-list :global(li:focus) { background: var(--brand-soft); outline: none; }
  .reg-cc-list :global(li img) { flex: none; border-radius: 2px; object-fit: cover; }
  .reg-cc-list :global(li span) { flex: 1; min-width: 0; }
  .reg-cc-list :global(li b) { color: var(--muted); font-variant-numeric: tabular-nums; }
  .reg input:focus { outline: 2px solid var(--teal); outline-offset: 0; border-color: var(--teal); }
  .reg-submit { width: 100%; padding: 14px; font-size: 1.05rem; background: #d92d20; }
  .reg-submit:hover { background: #b42318; }
  .reg-msg { margin: 0; font-weight: 700; color: var(--brand); }
  .reg-msg.bad { color: #b42318; }
  .reg-later { justify-self: center; border: 0; background: none; padding: 4px 8px; color: var(--muted); font: inherit; font-size: .9rem; font-weight: 700; cursor: pointer; text-decoration: underline; }
  .reg-tg { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 11px 14px; border-radius: 12px; background: #229ed9; color: #fff; font-weight: 800; text-decoration: none; transition: background .15s; }
  .reg-tg:hover { background: #1b87bb; }
  .reg-tg :global(.social-icon) { box-shadow: 0 0 0 2px #fff; border-radius: 50%; }
  :global(html.reg-open) { overflow: hidden; }
  /* Phones: a sheet that slides up from the bottom. */
  @media (max-width: 720px) {
    .reg { place-items: end stretch; padding: 0; }
    .reg-card { max-width: none; border-radius: 20px 20px 0 0; padding-bottom: calc(18px + env(safe-area-inset-bottom)); animation-name: reg-up; }
    @keyframes reg-up { from { transform: translateY(100%); } }
  }
  @media (prefers-reduced-motion: reduce) { .reg-card, .reg-shade { animation: none; } }
</style>
