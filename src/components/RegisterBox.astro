---
// Simple registration (name + email) that follows the visitor down the page.
// Desktop: a card in the bottom corner. Phone: a slim bar that opens into the form.
// Saved to the Supabase `subscribers` table; no password, no email is sent.
import { SITE } from "../site.config.mjs";
import { t, type Lang } from "../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<aside class="reg" data-reg data-lang={lang} data-ok={t(lang, "reg.ok")} data-err={t(lang, "reg.err")} data-fail={t(lang, "reg.fail")} hidden aria-label={t(lang, "reg.title")}>
  <button class="reg-bar" type="button" data-reg-open>
    <span>{t(lang, "reg.bar")}</span>
    <strong>{t(lang, "reg.submit")}</strong>
  </button>
  <div class="reg-card">
    <button class="reg-close" type="button" data-reg-close aria-label={t(lang, "reg.close")}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <p class="reg-title">{t(lang, "reg.title")}</p>
    <p class="reg-lead">{t(lang, "reg.lead")}</p>
    <form data-reg-form novalidate>
      <label class="visually-hidden" for={`reg-name-${lang}`}>{t(lang, "reg.name")}</label>
      <input id={`reg-name-${lang}`} name="name" type="text" required autocomplete="name" maxlength="80" placeholder={t(lang, "reg.name")} />
      <label class="visually-hidden" for={`reg-email-${lang}`}>{t(lang, "reg.email")}</label>
      <input id={`reg-email-${lang}`} name="email" type="email" required autocomplete="email" placeholder={t(lang, "reg.email")} />
      <button class="btn reg-submit" type="submit">{t(lang, "reg.submit")}</button>
    </form>
    <p class="reg-msg" data-reg-msg role="status" hidden></p>
    <a class="reg-tg" href={SITE.telegram} target="_blank" rel="noopener">Telegram ↗</a>
  </div>
</aside>

<script>
  import { getSupabase } from "../lib/client/supabase";
  const KEY = "sh-reg";
  const store = {
    get: () => { try { return JSON.parse(localStorage.getItem(KEY) || "{}"); } catch { return {}; } },
    set: (v: object) => { try { localStorage.setItem(KEY, JSON.stringify({ ...store.get(), ...v })); } catch {} },
  };
  const box = document.querySelector<HTMLElement>("[data-reg]");
  if (box) {
    const state = store.get();
    const snoozed = state.closed && Date.now() - state.closed < 3 * 864e5;
    const open = (expand: boolean) => { box.hidden = false; box.classList.toggle("expanded", expand); if (expand) box.querySelector<HTMLInputElement>("input")?.focus({ preventScroll: true }); };
    // Show after the visitor scrolls a little, unless they registered or closed it recently.
    if (!state.done && !snoozed) {
      const onScroll = () => { if (scrollY > 500) { open(innerWidth > 720); removeEventListener("scroll", onScroll); } };
      addEventListener("scroll", onScroll, { passive: true });
    }
    // The header "Register" button opens the box straight away.
    document.querySelectorAll<HTMLAnchorElement>("[data-reg-trigger]").forEach((a) => a.addEventListener("click", (e) => {
      if (store.get().done) return;
      e.preventDefault(); open(true);
    }));
    box.querySelector("[data-reg-open]")!.addEventListener("click", () => open(true));
    box.querySelector("[data-reg-close]")!.addEventListener("click", () => {
      store.set({ closed: Date.now() });
      if (innerWidth <= 720 && box.classList.contains("expanded")) box.classList.remove("expanded");
      else box.hidden = true;
    });
    const form = box.querySelector<HTMLFormElement>("[data-reg-form]")!;
    const msg = box.querySelector<HTMLElement>("[data-reg-msg]")!;
    const show = (text: string, ok: boolean) => { msg.hidden = false; msg.textContent = text; msg.classList.toggle("bad", !ok); };
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const name = (form.elements.namedItem("name") as HTMLInputElement).value.trim();
      const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim().toLowerCase();
      if (!name || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return show(box.dataset.err!, false);
      const btn = form.querySelector("button")!; btn.disabled = true;
      const sb = await getSupabase();
      const { error } = sb ? await sb.from("subscribers").insert({ name, email, lang: box.dataset.lang }) : { error: { code: "off" } as any };
      btn.disabled = false;
      // A duplicate email means they are already registered, which is fine.
      if (error && error.code !== "23505") return show(box.dataset.fail!, false);
      store.set({ done: Date.now() });
      form.hidden = true;
      show(box.dataset.ok!.replace("{name}", name.split(" ")[0]), true);
      setTimeout(() => (box.hidden = true), 4000);
    });
  }
</script>

<style>
  .reg { position: fixed; z-index: 60; inset-inline-end: 20px; bottom: 20px; width: 340px; max-width: calc(100vw - 32px); }
  .reg-bar { display: none; }
  .reg-card { position: relative; background: var(--surface); border: 1px solid var(--line); border-top: 4px solid #d92d20; border-radius: 16px; padding: 18px; box-shadow: 0 18px 40px rgb(12 43 76 / .25); display: grid; gap: 10px; animation: reg-in .3s ease-out; }
  @keyframes reg-in { from { transform: translateY(16px); opacity: 0; } }
  .reg:not(.expanded) .reg-card { display: none; }
  .reg:not(.expanded) .reg-bar { display: flex; }
  .reg-close { position: absolute; top: 10px; inset-inline-end: 10px; width: 32px; height: 32px; border-radius: 8px; border: 0; background: transparent; color: var(--muted); cursor: pointer; display: grid; place-items: center; }
  .reg-close:hover { background: var(--surface-2); color: var(--ink); }
  .reg-title { margin: 0; font-weight: 800; font-size: 1.15rem; color: var(--navy); padding-inline-end: 34px; }
  .reg-lead { margin: 0; color: var(--muted); font-size: .9rem; }
  .reg form { display: grid; gap: 8px; }
  .reg form[hidden] { display: none; }
  .reg input { width: 100%; padding: 11px 12px; border-radius: 10px; border: 1px solid var(--line); background: #fff; color: var(--ink); font-size: 1rem; }
  .reg input:focus { outline: 2px solid var(--teal); outline-offset: 0; border-color: var(--teal); }
  .reg-submit { width: 100%; background: #d92d20; }
  .reg-submit:hover { background: #b42318; }
  .reg-msg { margin: 0; font-weight: 700; color: var(--brand); }
  .reg-msg.bad { color: #b42318; }
  .reg-tg { justify-self: center; font-size: .85rem; font-weight: 700; color: #229ed9; text-decoration: none; }
  .reg-bar { width: 100%; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 10px 10px 16px; border: 0; border-radius: 14px; background: var(--navy); color: #fff; font: inherit; font-weight: 700; cursor: pointer; box-shadow: 0 10px 30px rgb(12 43 76 / .3); text-align: start; }
  .reg-bar strong { background: #d92d20; padding: 8px 14px; border-radius: 10px; white-space: nowrap; }
  @media (max-width: 720px) {
    .reg { inset-inline: 10px; bottom: 10px; width: auto; max-width: none; }
  }
</style>
