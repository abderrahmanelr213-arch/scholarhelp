---
import { t, lp, type Lang } from "../i18n/ui";
import { isoDate, formatDate, type Opp } from "../lib/opps";
interface Props { opp: Opp; lang: Lang }
const { opp, lang } = Astro.props;
const d = opp.entry.data;
const fundMatch = d.title.match(/^(.*?)\s*(\((?:fully|partially) funded\))\s*$/i);
const titleMain = fundMatch ? fundMatch[1] : d.title;
const fundTag = fundMatch ? fundMatch[2] : "";
const text = [d.title, d.host, d.country, opp.countryKey, d.summary, d.eligible, ...d.levels].join(" ").toLowerCase();
const href = lp(lang, `/opportunities/${opp.slug}/`);
const flag = d.countryCode ? `/flags/${d.countryCode.toLowerCase()}.svg` : "";
const isNew = Date.now() - +d.published < 7 * 86400000;
---
<article class="card" data-slug={opp.slug} data-cat={d.category} data-levels={d.levels.join(",")} data-funding={d.funding}
  data-country={opp.countryKey} data-deadline={isoDate(d.deadline)} data-published={isoDate(d.published)} data-text={text} data-new={isNew ? "1" : undefined}>
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
    {d.image
      ? <img src={d.image} alt="" loading="lazy" />
      : flag
        ? <span class="thumb-flag"><img src={flag} alt="" loading="lazy" width="96" height="72" /><span>{d.country}</span></span>
        : <span class="thumb-flag"><svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg><span>{t(lang, "card.worldwide")}</span></span>}
  </a>
  <span class="new-badge" data-new-badge hidden>{t(lang, "card.new")}</span>
  <button class="save" type="button" data-save={opp.slug} data-title={d.title} data-href={href} aria-pressed="false" aria-label={t(lang, "card.save")} title={t(lang, "card.save")}>
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.3-9.4C1.4 7.6 3.7 4 7.2 4c2 0 3.6 1.1 4.8 2.8C13.2 5.1 14.8 4 16.8 4c3.5 0 5.8 3.6 4.5 7.1-1.8 4.8-9.3 9.4-9.3 9.4z"/></svg>
  </button>
  <div class="card-body">
    <div class="card-top">
      <span class={`badge ${d.category}`}>{t(lang, `cat.${d.category}.short` as any)}</span>
      <span class={`badge funding ${d.funding}`}>
        <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true">
          {d.funding === "full" && <><circle cx="8" cy="8" r="7" fill="currentColor" /><path d="M4.8 8.2l2.1 2.1 4.3-4.6" fill="none" stroke="#d92d20" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></>}
          {d.funding === "partial" && <><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M8 1.8a6.2 6.2 0 0 1 0 12.4z" fill="currentColor" /></>}
          {d.funding === "travel" && <path d="M14.5 6.5 9.8 8 7 13H5.6l1.3-4.4-3.1.9L2.6 11H1.5l.6-3-.6-3h1.1l1.2 1.5 3.1.9L5.6 3H7l2.8 5 4.7 1.5z" fill="currentColor" transform="rotate(-90 8 8)" />}
        </svg>
        {t(lang, `funding.${d.funding}` as any)}
      </span>
    </div>
    <h3><a href={href}>{titleMain}{fundTag && <> <span class={`fund-tag ${d.funding}`}>{fundTag}</span></>}</a></h3>
    <div class="card-meta">
      {flag ? <img class="mini-flag" src={flag} alt="" width="20" height="15" /> : null}
      <span class="clip">{d.country}{d.host ? ` · ${d.host}` : ""}</span>
    </div>
    <div class="card-deadline">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
      {d.deadline ? <time datetime={isoDate(d.deadline)}>{formatDate(d.deadline, lang)}</time> : <span>{t(lang, "opp.rolling")}</span>}
      <span class="left" data-left hidden></span>
    </div>
    <a class="btn apply-now" href={href}>{t(lang, "card.applyNow")}
      <svg class="flip-rtl" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</article>
