---
// "Follow us" row: white round buttons with the real brand icons. Hover adds a teal ring (our touch).
import SocialIcon from "./SocialIcon.astro";
import { SITE } from "../site.config.mjs";
interface Props { label?: string; center?: boolean }
const { label, center = false } = Astro.props;
---
<div class:list={["follow-row", { center }]}>
  {label && <p class="follow-label">{label}</p>}
  <div class="follow-icons">
    <a class="follow-btn" href={SITE.telegram} target="_blank" rel="noopener" aria-label="Telegram" title="Telegram"><SocialIcon name="telegram" size={30} /></a>
    {SITE.social.instagram && <a class="follow-btn" href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" title="Instagram"><SocialIcon name="instagram" glyph size={28} /></a>}
  </div>
</div>
<style>
  .follow-row { display: grid; gap: 10px; }
  .follow-row.center { justify-items: center; text-align: center; }
  .follow-label { margin: 0; font-weight: 700; color: var(--ink); }
  .follow-icons { display: flex; gap: 14px; flex-wrap: wrap; }
  .follow-btn { width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center; background: #fff; border: 1.5px solid var(--line); box-shadow: 0 2px 6px rgb(12 43 76 / .06); transition: transform .15s, box-shadow .15s, border-color .15s; }
  .follow-btn:hover, .follow-btn:focus-visible { transform: translateY(-3px); border-color: var(--teal); box-shadow: 0 0 0 4px rgb(15 141 142 / .16), 0 8px 18px rgb(12 43 76 / .12); }
</style>
