---
import SocialLinks from "../components/SocialLinks.astro";
import RegisterBox from "../components/RegisterBox.astro";
import Logo from "../components/Logo.astro";
import "../styles/global.css";
import { SITE, LOCALES, CATEGORIES } from "../site.config.mjs";
import { t, lp, DIR, LANG_NAMES, OG_LOCALE, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path without the language prefix, e.g. "/opportunities/chevening/". Used for hreflang and the language switcher. */
  path: string;
  /** Languages this page exists in (defaults to all). */
  alternates?: Lang[];
  ogType?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { lang, title, description, path, alternates = LOCALES as Lang[], ogType = "website", jsonLd, noindex = false } = Astro.props;
const fullTitle = title === SITE.name ? `${SITE.name} | ${t(lang, "site.tagline")}` : `${title} | ${SITE.name}`;
const canonical = new URL(lp(lang, path), SITE.url).href;
const ogImage = new URL("/og-image.png", SITE.url).href;
const year = new Date().getFullYear();
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={lang} dir={DIR[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  {alternates.map((l) => <link rel="alternate" hreflang={l} href={new URL(lp(l, path), SITE.url).href} />)}
  <link rel="alternate" hreflang="x-default" href={new URL(lp("en", path), SITE.url).href} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0c2b4c" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  <meta name="twitter:card" content="summary_large_image" />
  {SITE.googleVerification && <meta name="google-site-verification" content={SITE.googleVerification} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" />
  {lang === "ar" && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@500;600;700&display=swap" />}
  {lang === "ps" && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@500;600;700;800&display=swap" />}
  {SITE.adsenseClient && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>}
  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body>
  <a class="skip visually-hidden" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="container bar">
      <a class="brand" href={lp(lang, "/")} aria-label={SITE.name}>
        <Logo variant="row" class="brand-logo" />
      </a>
      <nav class="nav" aria-label="Main">
        <a href={lp(lang, "/opportunities/")} aria-current={path === "/opportunities/" ? "page" : undefined}>{t(lang, "nav.opportunities")}</a>
        {CATEGORIES.map((c) => <a href={lp(lang, `/${c}/`)} aria-current={path === `/${c}/` ? "page" : undefined}>{t(lang, `cat.${c}.short` as any)}</a>)}
        <a href={lp(lang, "/guides/")} aria-current={path.startsWith("/guides/") ? "page" : undefined}>{t(lang, "nav.guides")}</a>
      </nav>
      <div class="bar-end">
        <details class="lang" data-lang-switch>
          <summary aria-label={t(lang, "nav.language")}>
            <svg class="globe" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="11.5" fill="var(--brand)" stroke="none"/><circle cx="12" cy="12" r="7.5"/><path d="M4.5 12h15M12 4.5c2 2.2 3.1 4.7 3.1 7.5s-1.1 5.3-3.1 7.5c-2-2.2-3.1-4.7-3.1-7.5S10 6.7 12 4.5z"/></svg>
            <span class="lang-label" data-names={JSON.stringify([lang, ...(LOCALES as Lang[]).filter((l) => l !== lang)].map((l) => LANG_NAMES[l]))}>{LANG_NAMES[lang]}</span>
          </summary>
          <ul>
            {(LOCALES as Lang[]).map((l) => (
              <li><a href={lp(l, alternates.includes(l) ? path : "/")} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined}>{LANG_NAMES[l]}</a></li>
            ))}
          </ul>
        </details>
        <a class="auth-link" href={lp(lang, "/account/")} data-auth-out>{t(lang, "nav.login")}</a>
        <a class="btn auth-btn register" href={lp(lang, "/account/") + "#signup"} data-auth-out data-reg-trigger>{t(lang, "nav.register")}</a>
        <a class="btn outline auth-btn" href={lp(lang, "/account/")} data-auth-in hidden>{t(lang, "nav.account")}</a>
        <details class="menu">
          <summary aria-label={t(lang, "nav.menu")}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </summary>
          <nav aria-label="Mobile">
            <a href={lp(lang, "/")}>{t(lang, "nav.home")}</a>
            <a href={lp(lang, "/opportunities/")}>{t(lang, "nav.opportunities")}</a>
            {CATEGORIES.map((c) => <a href={lp(lang, `/${c}/`)}>{t(lang, `cat.${c}` as any)}</a>)}
            <a href={lp(lang, "/guides/")}>{t(lang, "nav.guides")}</a>
            <a href={lp(lang, "/account/")}>{t(lang, "nav.account")}</a>
            <a href={SITE.telegram} target="_blank" rel="noopener">{t(lang, "nav.telegram")}</a>
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container foot-grid">
      <div class="foot-brand">
        <a class="foot-logo" href={lp(lang, "/")} aria-label={SITE.name}><Logo variant="stacked" animate={false} /></a>
        <p>{t(lang, "site.tagline")}</p>
        <SocialLinks label={t(lang, "opp.follow")} />
      </div>
      <nav aria-label="Categories">
        <a href={lp(lang, "/opportunities/")}>{t(lang, "browse.title")}</a>
        {CATEGORIES.map((c) => <a href={lp(lang, `/${c}/`)}>{t(lang, `cat.${c}` as any)}</a>)}
        <a href={lp(lang, "/guides/")}>{t(lang, "guides.title")}</a>
      </nav>
      <nav aria-label={SITE.name}>
        <a href={lp(lang, "/about/")}>{t(lang, "nav.about")}</a>
        <a href={lp(lang, "/contact/")}>{t(lang, "nav.contact")}</a>
        <a href={lp(lang, "/privacy/")}>{t(lang, "footer.privacy")}</a>
        <a href={lp(lang, "/terms/")}>{t(lang, "footer.terms")}</a>
      </nav>
    </div>
    <div class="container foot-bottom">
      <p>{t(lang, "footer.disclaimer")}</p>
      <p>© {year} {SITE.name}. {t(lang, "footer.rights")}</p>
    </div>
  </footer>
  {!path.startsWith("/account") && <RegisterBox lang={lang} />}
  <script>
    // Language switcher hint: the label cycles through the languages,
    // until the visitor opens the switcher once.
    (() => {
      const box = document.querySelector<HTMLDetailsElement>("[data-lang-switch]");
      const label = box?.querySelector<HTMLElement>(".lang-label");
      if (!box || !label) return;
      let seen = false;
      try { seen = localStorage.getItem("sh-lang-seen") === "1"; } catch {}
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      // The red Register button pops until the visitor registers.
      let registered = false;
      try { registered = !!JSON.parse(localStorage.getItem("sh-reg") || "{}").done; } catch {}
      if (!registered && !still) document.querySelectorAll(".register").forEach((el) => el.classList.add("pop"));
      if (seen || still) return;
      box.classList.add("hint");
      const names: string[] = JSON.parse(label.dataset.names || "[]");
      let i = 0;
      const timer = setInterval(() => {
        label.classList.add("out");
        setTimeout(() => { i = (i + 1) % names.length; label.textContent = names[i]; label.classList.remove("out"); }, 250);
      }, 2200);
      box.addEventListener("toggle", () => {
        if (!box.open) return;
        clearInterval(timer); box.classList.remove("hint"); label.classList.remove("out"); label.textContent = names[0];
        try { localStorage.setItem("sh-lang-seen", "1"); } catch {}
      }, { once: true });
    })();

    import { initSaveButtons } from "../lib/client/saved";
    import { currentUser } from "../lib/client/supabase";
    // Close the open dropdown when clicking elsewhere.
    document.addEventListener("click", (e) => {
      document.querySelectorAll("details[open]").forEach((d) => { if (!d.contains(e.target as Node)) d.removeAttribute("open"); });
    });
    initSaveButtons();
    currentUser().then((u) => {
      document.querySelectorAll<HTMLElement>("[data-auth-in]").forEach((el) => (el.hidden = !u));
      document.querySelectorAll<HTMLElement>("[data-auth-out]").forEach((el) => (el.hidden = !!u));
    });
  </script>
</body>
</html>

<style>
  .skip:focus { position: fixed; inset-inline-start: 12px; top: 12px; width: auto; height: auto; clip: auto; z-index: 100; background: var(--surface); padding: 8px 12px; }
  .site-header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 20px; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; flex: none; }
  .brand :global(.i) { height: 44px; width: auto; }
  .brand :global(.w) { height: 25px; width: auto; }
  .foot-logo { display: block; width: 160px; }
  .nav { display: flex; gap: 4px; }
  .nav a { position: relative; white-space: nowrap; padding: 8px 12px; border-radius: 8px; text-decoration: none; color: var(--navy); font-weight: 700; font-size: 1rem; }
  .nav a::after { content: ""; position: absolute; inset-inline: 12px; bottom: 2px; height: 2.5px; border-radius: 2px; background: var(--teal); transform: scaleX(0); transition: transform .15s; }
  .nav a:hover { color: var(--teal); }
  .nav a:hover::after, .nav a[aria-current="page"]::after { transform: scaleX(1); }
  .nav a[aria-current="page"] { color: var(--teal); }
  .bar-end { margin-inline-start: auto; display: flex; align-items: center; gap: 8px; }
  details { position: relative; }
  summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line); font-weight: 700; font-size: .85rem; }
  summary::-webkit-details-marker { display: none; }
  .lang ul { position: absolute; inset-inline-end: 0; top: calc(100% + 6px); margin: 0; padding: 6px; list-style: none; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; box-shadow: var(--shadow); min-width: 150px; }
  .lang-label { display: inline-block; min-width: 4.4em; text-align: center; transition: opacity .25s, transform .25s; }
  .lang-label.out { opacity: 0; transform: translateY(-6px); }
  .globe { flex: none; }
  .register.pop { animation: reg-pop 2.4s ease-in-out infinite; }
  @keyframes reg-pop {
    0%, 60%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgb(217 45 32 / .5); }
    70% { transform: scale(1.08); }
    80% { transform: scale(1); box-shadow: 0 0 0 10px rgb(217 45 32 / 0); }
  }
  .register.pop:hover { animation: none; }
  .lang a { display: block; padding: 8px 10px; border-radius: 6px; text-decoration: none; color: var(--ink); }
  .lang a:hover, .lang a[aria-current] { background: var(--surface-2); }
  .auth-link { font-weight: 700; color: var(--ink); text-decoration: none; padding: 8px 6px; white-space: nowrap; }
  .auth-btn { padding: 9px 16px; font-size: .92rem; white-space: nowrap; }
  .register { background: #d92d20; border-color: #d92d20; color: #fff; }
  .register:hover { background: #b42318; border-color: #b42318; }
  .social { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 10px; border: 1px solid var(--line); color: var(--ink); text-decoration: none; font-weight: 700; font-size: .9rem; }
  .social:hover { border-color: var(--teal); color: var(--brand); }
  .menu { display: none; }
  .menu nav { position: absolute; inset-inline-end: 0; top: calc(100% + 6px); display: grid; padding: 8px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; box-shadow: var(--shadow); min-width: 240px; }
  .menu nav a { padding: 10px; text-decoration: none; color: var(--navy); font-weight: 700; border-radius: 6px; }
  .menu nav a:hover { background: var(--surface-2); }
  @media (max-width: 1140px) {
    .nav { display: none; }
    .menu { display: block; }
  }
  @media (max-width: 560px) {
    .brand :global(.w) { display: none; }
    .auth-link { display: none; }
    .lang summary span { display: none; }
  }
  .site-footer { margin-top: 64px; background: var(--surface); border-top: 1px solid var(--line); padding-block: 40px 24px; }
  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 32px; }
  .foot-brand { display: grid; gap: 12px; align-content: start; justify-items: start; }
  .foot-brand img { height: 90px; width: auto; }
  .foot-brand p { color: var(--muted); max-width: 40ch; }
  .site-footer nav { display: grid; gap: 8px; align-content: start; }
  .site-footer nav a { color: var(--muted); text-decoration: none; }
  .site-footer nav a:hover { color: var(--ink); }
  .foot-bottom { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: .85rem; display: grid; gap: 4px; }
  .foot-bottom p { margin: 0; }
  @media (max-width: 720px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-brand { grid-column: 1 / -1; } }
</style>
